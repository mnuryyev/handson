---
const { title, desc, url, image, date, horizontal = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const cleanUrl = url.startsWith('/') ? url.slice(1) : url;
const finalUrl = `${base}${cleanUrl}`;
const cleanImage = image && image.startsWith('/') ? image.slice(1) : image;
const finalImage = image ? `${base}${cleanImage}` : null;
const formattedDate = date ? new Date(date).toISOString().split('T')[0] : "2026-01-01";
---
<a href={finalUrl} class={`lab-card${horizontal ? ' lab-card--h' : ''}`}>
  <div class="thumbnail">
    {finalImage ? (
      <img src={finalImage} alt={title} class="card-img" loading="lazy" />
    ) : (
      <div class="no-img">
        <div class="no-img-grid"></div>
        <span class="no-img-label">PREVIEW</span>
      </div>
    )}
    <div class="card-overlay"></div>
  </div>
  <div class="meta">
    <h3 class="title">{title}</h3>
    <p class="description">{desc}</p>
    <div class="footer-row">
      <span class="date">{formattedDate}</span>
      <span class="read-more">Читать →</span>
    </div>
  </div>
</a>

<style>
  /* ── БАЗОВЫЙ (вертикальный) вариант ─────────────────────── */
  .lab-card {
    color: inherit;
    display: flex;
    flex-direction: column;
    background: var(--card, #0f0f1a);
    border-radius: 14px;
    border: 1px solid var(--border, rgba(255,255,255,0.07));
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    position: relative;
    text-decoration: none !important;
  }

  .lab-card:hover {
    border-color: rgba(62, 166, 255, 0.35);
    transform: translateY(-4px);
    box-shadow:
      0 12px 40px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(62, 166, 255, 0.12),
      0 0 32px rgba(62, 166, 255, 0.06);
  }

  .thumbnail {
    width: 100%;
    position: relative;
    padding-top: 56.25%;
    overflow: hidden;
    flex-shrink: 0;
  }

  .card-img {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    margin: 0 !important;
    border: none !important;
    border-radius: 0 !important;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .lab-card:hover .card-img { transform: scale(1.06); }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(9,9,15,0.6) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .lab-card:hover .card-overlay { opacity: 1; }

  .no-img {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-3, #111120);
    overflow: hidden;
  }

  .no-img-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(62,166,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(62,166,255,0.04) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .no-img-label {
    position: relative;
    font-size: 0.65rem;
    letter-spacing: 3px;
    font-weight: 700;
    color: rgba(62,166,255,0.25);
    text-transform: uppercase;
  }

  .meta {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .title {
    margin: 0 0 8px;
    font-size: 1.05rem;
    color: #fff;
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none !important;
  }

  .description {
    margin: 0 0 auto;
    font-size: 0.875rem;
    color: var(--text-2, #7c8ca0);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
    padding-bottom: 14px;
  }

  .footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 12px;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .date {
    font-size: 0.72rem;
    color: var(--text-3, #3d4a5c);
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    letter-spacing: 0.3px;
  }

  .read-more {
    font-size: 0.78rem;
    color: var(--accent, #3ea6ff);
    font-weight: 500;
    opacity: 0;
    transform: translateX(-6px);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .lab-card:hover .read-more { opacity: 1; transform: translateX(0); }

  /* ── ГОРИЗОНТАЛЬНЫЙ вариант (листинг, только десктоп) ───── */
  @media (min-width: 769px) {
    .lab-card--h {
      flex-direction: row;
      height: 156px;
    }

    .lab-card--h:hover {
      transform: translateY(-2px);
    }

    .lab-card--h .thumbnail {
      width: 248px;
      min-width: 248px;
      flex-shrink: 0;
      padding-top: 0;
      height: 156px;
    }

    .lab-card--h .meta {
      padding: 18px 24px 16px;
      justify-content: space-between;
      flex-grow: 1;
      min-width: 0;
    }

    .lab-card--h .title {
      font-size: 1.1rem;
      margin-bottom: 6px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .lab-card--h .description {
      -webkit-line-clamp: 2;
      padding-bottom: 0;
      flex-grow: 0;
    }

    .lab-card--h .read-more {
      font-size: 0.82rem;
    }
  }
</style>
