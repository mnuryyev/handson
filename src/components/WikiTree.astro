---
const { tree, currentSlug = "", lang = "ru" } = Astro.props;

const sortedNodes = Object.entries(tree).sort(([aName, aNode], [bName, bNode]) => {
  if (aNode.type !== bNode.type) return aNode.type === 'folder' ? -1 : 1;
  return aName.localeCompare(bName);
});

function isFolderOpen(node, currentSlug) {
  if (!currentSlug) return false;
  const checkOpen = (n) => {
    if (n.type === 'file' && n.slug === currentSlug) return true;
    if (n.type === 'folder') return Object.values(n.children).some(child => checkOpen(child));
    return false;
  };
  return checkOpen(node);
}
---

{sortedNodes.map(([name, node]) => (
  <div class="tree-node">
    {node.type === 'folder' ? (
      <details open={isFolderOpen(node, currentSlug)}>
        <summary>
          <svg class="chevron" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
          </svg>
          <svg class="icon-folder" viewBox="0 0 20 20" fill="currentColor">
            <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/>
          </svg>
          <span class="node-name">{name}</span>
        </summary>
        <div class="folder-content">
          <Astro.self tree={node.children} currentSlug={currentSlug} lang={lang} />
        </div>
      </details>
    ) : (
      <a href={`/handson/${lang}/wiki/${node.slug}`}
         class={`file-link ${currentSlug === node.slug ? 'active' : ''}`}>
        <svg class="icon-file" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/>
        </svg>
        <span class="node-name">{node.title}</span>
      </a>
    )}
  </div>
))}

<style>
  .tree-node { user-select: none; }

  summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    cursor: pointer;
    border-radius: 6px;
    color: var(--text-2, #7c8ca0);
    font-size: 0.8125rem;
    line-height: 1.45;
    transition: background 0.15s, color 0.15s;
  }

  summary:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #e2e8f0;
  }

  summary::-webkit-details-marker { display: none; }

  .chevron {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    color: var(--text-3, #3d4a5c);
    transition: transform 0.2s ease;
  }

  details[open] > summary > .chevron {
    transform: rotate(90deg);
  }

  .icon-folder {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--accent, #3ea6ff);
    opacity: 0.55;
  }

  .icon-file {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    color: var(--text-3, #3d4a5c);
    transition: color 0.15s;
  }

  .folder-content {
    margin-left: 18px;
    padding-left: 1px;
    border-left: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: 1px;
    display: flex;
    flex-direction: column;
  }

  .file-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px 4px 6px;
    text-decoration: none;
    color: var(--text-2, #7c8ca0);
    font-size: 0.8125rem;
    line-height: 1.45;
    border-radius: 6px;
    transition: background 0.15s, color 0.15s;
  }

  .file-link:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #e2e8f0;
  }

  .file-link:hover .icon-file {
    color: var(--accent, #3ea6ff);
    opacity: 0.7;
  }

  .file-link.active {
    background: rgba(62, 152, 219, 0.1);
    color: var(--accent, #3ea6ff);
    font-weight: 500;
  }

  .file-link.active .icon-file {
    color: var(--accent, #3ea6ff);
    opacity: 0.8;
  }

  .node-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  details { display: block; }
</style>
