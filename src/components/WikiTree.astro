---
// src/components/WikiTree.astro
const { tree, currentSlug = "", lang = "ru" } = Astro.props; // Добавили lang (по умолчанию ru)

// Сортируем: сначала папки, потом файлы
const sortedNodes = Object.entries(tree).sort(([aName, aNode], [bName, bNode]) => {
  if (aNode.type !== bNode.type) return aNode.type === 'folder' ? -1 : 1;
  return aName.localeCompare(bName);
});

// Функция для проверки, нужно ли раскрыть папку
function isFolderOpen(node, currentSlug) {
  if (!currentSlug) return false;
  
  const checkOpen = (n) => {
    if (n.type === 'file' && n.slug === currentSlug) return true;
    if (n.type === 'folder') {
      return Object.values(n.children).some(child => checkOpen(child));
    }
    return false;
  };
  return checkOpen(node);
}
---

{sortedNodes.map(([name, node]) => (
  <div class="tree-node">
    {node.type === 'folder' ? (
      <details open={isFolderOpen(node, currentSlug)}>
        <summary>
          <svg class="chevron" viewBox="0 0 24 24">
            <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
          </svg>
          <span class="folder-icon">📁</span>
          <span class="node-name">{name}</span>
        </summary>
        <div class="folder-content">
          {/* Передаем lang дальше в рекурсию */}
          <Astro.self tree={node.children} currentSlug={currentSlug} lang={lang} />
        </div>
      </details>
    ) : (
      /* Теперь ссылка зависит от выбранного языка */
      <a href={`/handson/${lang}/wiki/${node.slug}`} 
         class={`file-link ${currentSlug === node.slug ? 'active' : ''}`}>
        <span class="file-icon">📄</span>
        <span class="node-name">{node.title}</span>
      </a>
    )}
  </div>
))}

<style>
  .tree-node {
    user-select: none;
  }

  summary {
    list-style: none;
    display: flex;
    align-items: center;
    padding: 3px 6px; 
    cursor: pointer;
    border-radius: 4px;
    color: #999;
    /* Ровно 13.5px */
    font-size: 0.84375rem; 
    line-height: 1.4;
    transition: 0.1s ease;
  }

  summary:hover, .file-link:hover {
    background: #1a1a1a;
    color: #eee;
  }

  summary::-webkit-details-marker { display: none; }

  .chevron {
    width: 14px;
    height: 14px;
    fill: currentColor;
    transition: transform 0.2s;
    opacity: 0.4;
    flex-shrink: 0;
  }

  details[open] > summary > .chevron {
    transform: rotate(90deg);
  }

  .folder-icon, .file-icon {
    font-size: 0.9rem;
    margin: 0 5px;
    opacity: 0.6;
  }

  .folder-content {
    margin-left: 10px;
    border-left: 1px solid #1a1a1a;
    display: flex;
    flex-direction: column;
    margin-top: 1px;
  }

  .file-link {
    display: flex;
    align-items: center;
    padding: 3px 6px 3px 23px; 
    text-decoration: none;
    color: #777;
    font-size: 0.84375rem; 
    line-height: 1.4;
    border-radius: 4px;
    transition: 0.1s ease;
  }

  .file-link.active {
    background: rgba(52, 152, 219, 0.1);
    color: #3498db;
    font-weight: 500;
  }

  .node-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  details {
    display: block;
  }
</style>
