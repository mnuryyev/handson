---
// src/components/WikiTree.astro
const { tree, currentSlug = "" } = Astro.props;

// Сортируем: сначала папки, потом файлы (как в Obsidian)
const sortedNodes = Object.entries(tree).sort(([aName, aNode], [bName, bNode]) => {
  if (aNode.type !== bNode.type) return aNode.type === 'folder' ? -1 : 1;
  return aName.localeCompare(bName);
});

// Функция для проверки, нужно ли раскрыть папку
function isFolderOpen(node, currentSlug) {
  if (!currentSlug) return false;
  
  const checkOpen = (n) => {
    if (n.type === 'file' && n.slug === currentSlug) return true;
    if (n.type === 'folder') {
      return Object.values(n.children).some(child => checkOpen(child));
    }
    return false;
  };
  return checkOpen(node);
}
---

{sortedNodes.map(([name, node]) => (
  <div class="tree-node">
    {node.type === 'folder' ? (
      <details open={isFolderOpen(node, currentSlug)}>
        <summary>
          <svg class="chevron" viewBox="0 0 24 24"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/></svg>
          <span class="folder-icon">📁</span>
          <span class="node-name">{name}</span>
        </summary>
        <div class="folder-content">
          <Astro.self tree={node.children} currentSlug={currentSlug} />
        </div>
      </details>
    ) : (
      <a href={`/handson/ru/wiki/${node.slug}`} 
         class={`file-link ${currentSlug === node.slug ? 'active' : ''}`}>
        <span class="file-icon">📄</span>
        <span class="node-name">{node.title}</span>
      </a>
    )}
  </div>
))}

<style>
  .tree-node {
    user-select: none;
    margin-bottom: 2px;
  }

  summary {
    list-style: none;
    display: flex;
    align-items: center;
    /* Увеличенные отступы для удобства клика */
    padding: 6px 10px; 
    cursor: pointer;
    border-radius: 6px;
    color: #b0b0b0;
    /* Увеличенный шрифт */
    font-size: 0.95rem; 
    transition: all 0.15s ease;
  }

  summary:hover, .file-link:hover {
    background: #1e1e1e;
    color: #fff;
  }

  summary::-webkit-details-marker { display: none; }

  .chevron {
    /* Чуть крупнее иконка стрелочки */
    width: 18px;
    height: 18px;
    fill: currentColor;
    transition: transform 0.2s;
    opacity: 0.4;
  }

  details[open] > summary > .chevron {
    transform: rotate(90deg);
  }

  .folder-icon, .file-icon {
    /* Размер эмодзи/иконок */
    font-size: 1.05rem; 
    margin: 0 8px;
    opacity: 0.8;
  }

  .folder-content {
    /* Отступ линии вложенности */
    margin-left: 14px;
    border-left: 1px solid #222;
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin-top: 1px;
  }

  .file-link {
    display: flex;
    align-items: center;
    /* Больше отступ слева, чтобы текст был под текстом папки */
    padding: 6px 10px 6px 30px; 
    text-decoration: none;
    color: #888;
    /* Увеличенный шрифт */
    font-size: 0.95rem; 
    border-radius: 6px;
    transition: all 0.1s ease;
  }

  .file-link.active {
    background: rgba(52, 152, 219, 0.12);
    color: #3498db;
    font-weight: 500;
  }

  .node-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 0.01em;
  }

  /* Тонкая настройка: если папка открыта, текст становится чуть ярче */
  details[open] > summary {
    color: #eee;
  }
</style>
