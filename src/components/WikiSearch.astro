---
const { lang = "ru", searchData = [] } = Astro.props;
---

<div class="search-wrapper">
  <button id="search-btn" class="search-trigger" type="button">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <span>{lang === 'ru' ? 'Поиск...' : 'Search...'}</span>
    <kbd>⌘K</kbd>
  </button>
</div>

<div id="search-modal" class="modal">
  <div class="modal-content">
    <div class="search-header">
       <input type="text" id="search-input" placeholder={lang === 'ru' ? 'Введите название статьи...' : 'Type to search...'} autocomplete="off" />
    </div>
    <div id="search-results" class="results"></div>
  </div>
</div>

<style>
  .search-wrapper {
    width: 100%;
    padding: 0 5px;
  }

  .search-trigger {
    width: 100%;
    background: #111;
    border: 1px solid #222;
    color: #666;
    padding: 8px 12px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }

  .search-trigger:hover {
    border-color: #444;
    color: #aaa;
    background: #161616;
  }

  .search-trigger kbd {
    margin-left: auto;
    font-size: 0.7rem;
    background: #222;
    padding: 2px 5px;
    border-radius: 3px;
    color: #444;
    font-family: sans-serif;
  }

  /* МОДАЛКА: Используем opacity и pointer-events, чтобы не блокировать клики под ней */
  .modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    z-index: 99999; /* Максимальный приоритет */
    display: flex;
    justify-content: center;
    padding-top: 100px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none; /* ПРОПУСКАЕТ КЛИКИ СКВОЗЬ СЕБЯ */
    transition: all 0.2s ease;
    backdrop-filter: blur(4px);
  }

  .modal.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto; /* ВКЛЮЧАЕТ КЛИКИ, КОГДА ОТКРЫТО */
  }

  .modal-content {
    width: 100%;
    max-width: 600px;
    margin: 0 20px;
    background: #0d0d0d;
    border: 1px solid #333;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
    transform: translateY(-20px);
    transition: transform 0.2s ease;
  }

  .modal.open .modal-content {
    transform: translateY(0);
  }

  #search-input {
    width: 100%;
    background: #161616;
    border: none;
    border-bottom: 1px solid #222;
    padding: 20px;
    color: #fff;
    font-size: 1.1rem;
    outline: none;
  }

  .results {
    max-height: 400px;
    overflow-y: auto;
    padding: 10px;
  }

  /* Глобальные стили для динамических ссылок */
  :global(.result-item) {
    display: block;
    padding: 12px 15px;
    color: #888;
    text-decoration: none;
    border-radius: 8px;
    margin-bottom: 5px;
    transition: 0.2s;
    border: 1px solid transparent;
  }

  :global(.result-item:hover) {
    background: #1a1a1a;
    color: #3498db;
    border-color: #333;
  }

  :global(.result-item b) {
    display: block;
    color: #fff;
    font-size: 1rem;
    margin-bottom: 2px;
  }

  :global(.result-item small) {
    font-size: 0.75rem;
    opacity: 0.5;
    font-family: monospace;
  }
</style>

<script is:inline define:vars={{ searchData, lang }}>
  const btn = document.getElementById('search-btn');
  const modal = document.getElementById('search-modal');
  const input = document.getElementById('search-input');
  const resultsDiv = document.getElementById('search-results');

  const openModal = () => {
    modal.classList.add('open');
    setTimeout(() => input.focus(), 50);
  };

  const closeModal = () => {
    modal.classList.remove('open');
    input.value = '';
    resultsDiv.innerHTML = '';
  };

  btn.onclick = (e) => {
    e.stopPropagation();
    openModal();
  };

  // Закрытие при клике на фон
  modal.onclick = (e) => {
    if (e.target === modal) closeModal();
  };

  window.onkeydown = (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      modal.classList.contains('open') ? closeModal() : openModal();
    }
    if (e.key === 'Escape') closeModal();
  };

  input.oninput = (e) => {
    const query = e.target.value.toLowerCase().trim();
    resultsDiv.innerHTML = '';
    
    if (query.length < 2) return;

    const filtered = searchData
      .filter(item => 
        item.title.toLowerCase().includes(query) || 
        item.slug.toLowerCase().includes(query)
      )
      .slice(0, 10);

    if (filtered.length === 0) {
      resultsDiv.innerHTML = `<div style="padding: 20px; color: #444; text-align: center;">${lang === 'ru' ? 'Ничего не найдено' : 'No results found'}</div>`;
      return;
    }

    filtered.forEach(item => {
      const a = document.createElement('a');
      a.className = 'result-item';
      // Ссылка должна вести на /handson/ru/wiki/...
      // Проверяем, есть ли уже /handson/ в начале slug
      const finalUrl = item.slug.startsWith('handson') ? `/${item.slug}` : `/handson/${item.slug}`;
      a.href = finalUrl;
      a.innerHTML = `<b>${item.title}</b><small>${item.slug}</small>`;
      resultsDiv.appendChild(a);
    });
  };
</script>
