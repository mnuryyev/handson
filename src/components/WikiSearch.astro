---
const { lang = "ru", searchData = [] } = Astro.props;
---

<div class="search-wrapper">
  <button id="search-btn" class="search-trigger" type="button">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <span>{lang === 'ru' ? 'Поиск по базе...' : 'Search wiki...'}</span>
    <kbd>⌘K</kbd>
  </button>
</div>

<div id="search-modal" class="modal">
  <div class="modal-content">
    <input type="text" id="search-input" placeholder={lang === 'ru' ? 'Поиск (заголовки или текст)...' : 'Search titles or content...'} autocomplete="off" />
    <div id="search-results" class="results"></div>
  </div>
</div>

<style>
  .search-wrapper {
    width: 100%;
    /* Убираем падинги и маржины здесь, так как они заданы в WikiLayout */
    padding: 0;
    margin: 0;
  }

  .search-trigger {
    width: 100%;
    height: 40px; /* Фиксированная высота кнопки для стабильности */
    background: #111;
    border: 1px solid #222;
    color: #555;
    padding: 0 14px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    font-size: 0.8rem;
    transition: all 0.2s ease;
  }

  .search-trigger:hover {
    border-color: #333;
    background: #151515;
    color: #888;
  }

  .search-trigger kbd {
    margin-left: auto;
    font-size: 0.65rem;
    background: #1d1d1d;
    padding: 2px 6px;
    border-radius: 4px;
    color: #444;
    border: 1px solid #252525;
  }

  /* Модальное окно */
  .modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    z-index: 99999;
    display: flex;
    justify-content: center;
    padding-top: 100px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: all 0.2s ease;
    backdrop-filter: blur(8px);
  }

  .modal.open { 
    opacity: 1; 
    visibility: visible; 
    pointer-events: auto; 
  }

  .modal-content {
    width: 100%;
    max-width: 650px;
    margin: 0 20px;
    background: #0a0a0a;
    border: 1px solid #222;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(0,0,0,0.8);
    transform: translateY(-10px);
    transition: transform 0.2s ease;
  }

  .modal.open .modal-content { 
    transform: translateY(0); 
  }

  #search-input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid #1a1a1a;
    padding: 22px;
    color: #fff;
    font-size: 1.1rem;
    outline: none;
  }

  .results { 
    max-height: 450px; 
    overflow-y: auto; 
    padding: 12px; 
  }

  /* Глобальные стили для результатов */
  :global(.result-item) {
    display: block;
    padding: 14px 18px;
    color: #888;
    text-decoration: none;
    border-radius: 10px;
    margin-bottom: 4px;
    transition: 0.2s;
    border: 1px solid transparent;
  }

  :global(.result-item:hover) { 
    background: #111; 
    border-color: #222;
    color: #3498db; 
  }

  :global(.result-item b) { 
    display: block; 
    color: #fff; 
    font-size: 1rem; 
    margin-bottom: 4px; 
  }

  :global(.result-item p) { 
    margin: 0; 
    font-size: 0.85rem; 
    color: #555; 
    overflow: hidden; 
    text-overflow: ellipsis; 
    white-space: nowrap; 
  }
</style>

<script is:inline define:vars={{ searchData, lang }}>
  const btn = document.getElementById('search-btn');
  const modal = document.getElementById('search-modal');
  const input = document.getElementById('search-input');
  const resultsDiv = document.getElementById('search-results');

  const openModal = () => { 
    modal.classList.add('open'); 
    setTimeout(() => input.focus(), 50); 
  };
  
  const closeModal = () => { 
    modal.classList.remove('open'); 
    input.value = ''; 
    resultsDiv.innerHTML = ''; 
  };

  btn.onclick = (e) => { 
    e.stopPropagation(); 
    openModal(); 
  };
  
  modal.onclick = (e) => { 
    if (e.target === modal) closeModal(); 
  };

  window.onkeydown = (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') { 
      e.preventDefault(); 
      modal.classList.contains('open') ? closeModal() : openModal(); 
    }
    if (e.key === 'Escape') closeModal();
  };

  input.oninput = (e) => {
    const query = e.target.value.toLowerCase().trim();
    resultsDiv.innerHTML = '';
    if (query.length < 2) return;

    const filtered = searchData
      .filter(item => 
        item.title.toLowerCase().includes(query) || 
        (item.content && item.content.toLowerCase().includes(query))
      )
      .slice(0, 15);

    if (filtered.length === 0) {
      resultsDiv.innerHTML = `<div style="padding: 30px; color: #333; text-align: center;">${lang === 'ru' ? 'Ничего не найдено' : 'No results found'}</div>`;
      return;
    }

    filtered.forEach(item => {
      const a = document.createElement('a');
      a.className = 'result-item';
      // Проверяем наличие префикса в slug
      const finalUrl = item.slug.startsWith('handson') ? `/${item.slug}` : `/handson/${item.slug}`;
      a.href = finalUrl;
      
      let snippet = item.content ? item.content.substring(0, 80) + '...' : '';
      
      a.innerHTML = `
        <b>${item.title}</b>
        <p>${snippet}</p>
      `;
      resultsDiv.appendChild(a);
    });
  };
</script>
