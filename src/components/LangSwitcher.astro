---
const { pathname } = Astro.url;
const base = import.meta.env.BASE_URL;

const isEn = pathname.includes('/en/');
const currentLang = isEn ? 'en' : 'ru';

let targetPath;
if (isEn) {
  targetPath = pathname.replace('/en/', '/ru/');
} else if (pathname.includes('/ru/')) {
  targetPath = pathname.replace('/ru/', '/en/');
} else {
  targetPath = `${base}en/`;
}
---

<div class="lang-switch">
  <a
    href={isEn ? targetPath : pathname}
    class={currentLang === 'ru' ? 'lang-btn active' : 'lang-btn'}
  >RU</a>

  <span class="sep">/</span>

  <a
    href={isEn ? pathname : targetPath}
    class={currentLang === 'en' ? 'lang-btn active' : 'lang-btn'}
  >EN</a>
</div>

<style>
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 3px;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .lang-btn {
    color: var(--text-3, #3d4a5c);
    padding: 3px 5px;
    border-radius: 5px;
    transition: color 0.2s;
    letter-spacing: 0.3px;
  }

  .lang-btn.active {
    color: #fff;
    pointer-events: none;
  }

  .lang-btn:hover:not(.active) {
    color: var(--accent, #3ea6ff);
  }

  .sep {
    color: var(--text-3, #3d4a5c);
    font-weight: 400;
  }
</style>
