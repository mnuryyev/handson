---
import { getCollection } from 'astro:content';
import WikiLayout from '../../../layouts/WikiLayout.astro';
import WikiTree from '../../../components/WikiTree.astro';

// 1. Get all entries
const allEntries = await getCollection('wiki');

// 2. Filter for English entries only
const enEntries = allEntries.filter(item => item.id.startsWith('en/'));

// 3. SEARCH DATA PREPARATION (Full-text enabled)
const searchData = enEntries.map(page => ({
  title: page.data.title || page.id.split('/').pop().replace('.md', ''),
  content: page.body.toLowerCase().replace(/[#*`>]/g, '').substring(0, 500),
  slug: `en/wiki/${page.id.replace(/^en\//, '').replace(/\.md$/, '')}`
}));

// 4. Tree builder logic
function buildTree(entries) {
  const tree = {};
  entries.forEach(item => {
    const cleanId = item.id.replace(/^en\//, '').replace(/\.md$/, '');
    const parts = cleanId.split('/');
    let current = tree;
    parts.forEach((part, index) => {
      if (!current[part]) {
        if (index === parts.length - 1) {
          current[part] = { 
            type: 'file', 
            title: item.data?.title || part, 
            slug: cleanId 
          };
        } else {
          current[part] = { type: 'folder', children: {} };
        }
      }
      if (current[part].type === 'folder') current = current[part].children;
    });
  });
  return tree;
}

const fileTree = buildTree(enEntries);
---

<WikiLayout title="Wiki Knowledge Base" lang="en" searchData={searchData}>
  <WikiTree slot="sidebar" tree={fileTree} currentSlug="" lang="en" />
  
  <div class="obsidian-style-empty">
    <div class="welcome-box">
      <div class="icon">🚀</div>
      <h2>Welcome to Wiki</h2>
      <p>Select a topic from the sidebar or use search (⌘K).</p>
    </div>
  </div>
</WikiLayout>

<style>
  .obsidian-style-empty {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
  }
  
  .welcome-box {
    text-align: center;
    background: #111;
    padding: 50px 80px;
    border-radius: 16px;
    border: 1px solid #1a1a1a;
    max-width: 500px;
  }
  
  .welcome-box .icon {
    font-size: 3.5rem;
    margin-bottom: 20px;
    display: block;
    opacity: 0.8;
  }
  
  .welcome-box h2 {
    color: #fff;
    font-size: 1.8rem;
    margin-bottom: 12px;
    font-weight: 500;
  }
  
  .welcome-box p {
    color: #666;
    font-size: 1rem;
    line-height: 1.5;
  }
</style>
