---
import { getCollection, render } from 'astro:content';
import WikiLayout from '../../../layouts/WikiLayout.astro';
import WikiTree from '../../../components/WikiTree.astro';

export async function getStaticPaths() {
  const wikiEntries = await getCollection('wiki');
  // 1. Берем только английские файлы
  const enEntries = wikiEntries.filter(entry => entry.id.startsWith('en/'));
  
  return enEntries.map(entry => ({
    // Убираем 'en/' из начала slug для URL
    params: { slug: entry.id.replace(/^en\//, '').replace(/\.md$/, '') }, 
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allEntries = await getCollection('wiki');

// 2. Оставляем только английские записи для дерева в сайдбаре
const enEntries = allEntries.filter(item => item.id.startsWith('en/'));
const currentSlug = Astro.params.slug || '';

function buildTree(entries) {
  const tree = {};
  entries.forEach(item => {
    // Убираем префикс 'en/', чтобы дерево не начиналось с папки "en"
    const cleanId = item.id.replace(/^en\//, '').replace(/\.md$/, '');
    const parts = cleanId.split('/');
    let current = tree;

    parts.forEach((part, index) => {
      if (!current[part]) {
        if (index === parts.length - 1) {
          current[part] = { 
            type: 'file', 
            title: item.data?.title || part, 
            slug: cleanId 
          };
        } else {
          current[part] = { type: 'folder', children: {} };
        }
      }
      if (current[part].type === 'folder') {
        current = current[part].children;
      }
    });
  });
  return tree;
}

const fileTree = buildTree(enEntries);
---

<WikiLayout title={entry.data.title}>
  <WikiTree slot="sidebar" tree={fileTree} currentSlug={currentSlug} lang="en" />
  
  <Content />
</WikiLayout>

<style>
  /* Здесь стили обычно не нужны, так как контент стилизуется в WikiLayout 
     через класс .markdown-body, а дерево — внутри WikiTree.astro 
  */
  .wiki-tree-container {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
</style>
