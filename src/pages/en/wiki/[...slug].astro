---
import { getCollection, render } from 'astro:content';
import WikiLayout from '../../../layouts/WikiLayout.astro';
import WikiTree from '../../../components/WikiTree.astro';

export async function getStaticPaths() {
  const wikiEntries = await getCollection('wiki');
  const enEntries = wikiEntries.filter(entry => entry.id.startsWith('en/'));
  
  return enEntries.map(entry => ({
    params: { slug: entry.id.replace(/^en\//, '').replace(/\.md$/, '') }, 
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allEntries = await getCollection('wiki');

const enEntriesForSidebar = allEntries.filter(item => item.id.startsWith('en/'));
const currentSlug = Astro.params.slug || '';

const searchData = enEntriesForSidebar.map(page => ({
  title: page.data.title || page.id.split('/').pop().replace('.md', ''),
  content: page.body.toLowerCase().replace(/[#*`>]/g, '').substring(0, 500),
  slug: `en/wiki/${page.id.replace(/^en\//, '').replace(/\.md$/, '')}`
}));

function buildTree(entries) {
  const tree = {};
  entries.forEach(item => {
    const cleanId = item.id.replace(/^en\//, '').replace(/\.md$/, '');
    const parts = cleanId.split('/');
    let current = tree;

    parts.forEach((part, index) => {
      const isLast = index === parts.length - 1;

      if (isLast) {
        // Это файл
        current[part] = { 
          type: 'file', 
          title: item.data?.title || part, 
          slug: cleanId 
        };
      } else {
        // Это папка. Если её нет — создаем.
        if (!current[part]) {
          current[part] = { type: 'folder', children: {} };
        }
        // Переходим глубже
        current = current[part].children;
      }
    });
  });
  return tree;
}

const fileTree = buildTree(enEntriesForSidebar);
---

<WikiLayout 
  title={entry.data.title} 
  date={entry.data.date} 
  lang="en" 
  searchData={searchData}
>
  <div slot="sidebar">
    <WikiTree tree={fileTree} currentSlug={currentSlug} lang="en" />
  </div>
  <Content />
</WikiLayout>

<style>
  .wiki-tree-container { display: flex; flex-direction: column; gap: 2px; }
</style>
