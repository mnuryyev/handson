---
import MainLayout from '../../../layouts/MainLayout.astro';

const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base : `${base}/`;
const lang = "en";

const platforms = [
  {
    id: 'thm',
    title: 'TryHackMe',
    description: 'Walkthroughs of rooms, learning paths, and practice machines from THM',
    icon: '/handson/images/neighbour_thm/thm_main.png', 
    color: '#cc2929'
  },
  {
    id: 'htb',
    title: 'HackTheBox',
    description: 'Detailed writeups for machines and challenges from HTB labs',
    icon: '/handson/images/meow_htb/htb_main.jpg', 
    color: '#9fe52d'
  }
];
---

<MainLayout title="Writeups - Select Platform">
  <div class="container">
    <header class="page-header">
      <h1>🎯 Practice & Writeups</h1>
      <p>Challenge solutions, writeups, and notes on penetration testing and system security</p>
    </header>

    <div class="platform-grid">
      {platforms.map(platform => (
        <a href={`${cleanBase}${lang}/writeups/${platform.id}/1`} class={`platform-card ${platform.id}`}>
          <div class="icon-box">
            <img src={platform.icon} alt={platform.title} />
          </div>
          <div class="text-box">
            <h2>{platform.title}</h2>
            <p>{platform.description}</p>
          </div>
          <div class="arrow">→</div>
        </a>
      ))}
    </div>
  </div>
</MainLayout>

<style>
  /* --- КОНТЕЙНЕР И СЕТКА --- */
  .container { max-width: 1300px; margin: 40px auto; padding: 0 20px; width: 100%; }
  
  .page-header { margin-bottom: 40px; text-align: center; }
  .page-header h1 { font-size: 1.8rem; color: #fff; margin-bottom: 10px; }
  .page-header p { color: #ccc; }
  
  .platform-grid { 
    display: grid; 
    /* minmax(280px) исправляет проблему вылезания за края на маленьких смартфонах */
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); 
    gap: 25px; 
    justify-content: center;
  }
  
  /* --- КАРТОЧКА --- */
  .platform-card {
    text-decoration: none !important; /* Убираем подчеркивание текста */
    background: #0d0d0d;
    border: 1px solid #222;
    border-radius: 20px;
    padding-bottom: 40px; 
    position: relative;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    width: 100%;
    /* Сбрасываем возможные нижние границы от общих стилей */
    border-bottom: 1px solid #222; 
  }

  .platform-card:hover { 
    text-decoration: none !important;
    transform: translateY(-5px); 
    border-color: #333; 
    background: #111; 
  }

  /* --- ИЗОБРАЖЕНИЕ --- */
  .icon-box { 
    width: 100%; 
    height: 180px; 
    display: flex; 
    align-items: center; 
    justify-content: center;
    margin-bottom: 20px; 
    position: relative;
    overflow: hidden;
    background: #050505;
  }

  .icon-box img { 
    width: 100%; 
    height: 100%; 
    object-fit: cover; 
    filter: brightness(0.7); 
    transition: all 0.4s ease;
  }
  
  .platform-card:hover .icon-box img {
    filter: brightness(1);
    transform: scale(1.05);
  }

  /* --- ТЕКСТ --- */
  .text-box { padding: 0 25px; }
  .text-box h2 { 
    color: #fff; 
    font-size: 1.5rem; 
    margin-bottom: 10px; 
    text-decoration: none !important; 
  }
  .text-box p { 
    color: #aaa; 
    font-size: 0.95rem; 
    margin-right: 0; 
    line-height: 1.4; 
    text-decoration: none !important; 
  }
  
  /* --- СТРЕЛКА --- */
  .arrow { 
    position: absolute;
    bottom: 25px; 
    right: 25px;
    color: #444; 
    font-size: 1.8rem; 
    transition: all 0.3s ease; 
  }
  
  .platform-card:hover .arrow { 
    color: var(--accent, #3ea6ff); 
    transform: translateX(5px); 
  }

  /* --- ЦВЕТА ПЛАТФОРМ --- */
  .thm .icon-box { border-bottom: 3px solid #cc2929; }
  .htb .icon-box { border-bottom: 3px solid #9fe52d; }

  /* --- АДАПТИВНОСТЬ --- */
  @media (max-width: 768px) {
    .container { margin: 20px auto; }
    .page-header h1 { font-size: 1.5rem; }
  }

  @media (max-width: 480px) {
    .icon-box { height: 150px; }
    .text-box h2 { font-size: 1.3rem; }
    .arrow { font-size: 1.4rem; bottom: 20px; right: 20px; }
  }
</style>
