---
import MainLayout from '../../../layouts/MainLayout.astro';
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';
import { marked } from 'marked';

const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base : `${base}/`;
const lang = "en";

export async function getStaticPaths() {
  // Путь к английскому контенту
  const labsDir = './src/content/writeups/en';
  if (!fs.existsSync(labsDir)) return [];

  const files = fs.readdirSync(labsDir).filter(f => f.endsWith('.md'));

  return files.map(file => ({
    params: { slug: file.replace('.md', '') }
  }));
}

const { slug } = Astro.params;

// Читаем файл из папки /en/
const filePath = path.join('./src/content/writeups/en', `${slug}.md`);
const fileContent = fs.readFileSync(filePath, 'utf-8');
const { data, content } = matter(fileContent);

const htmlContent = marked.parse(content);
---

<MainLayout title={data.title}>
  <div class="article-container">
    <nav class="breadcrumb">
      <a href={`${cleanBase}${lang}/writeups`}>Writeups</a> 
      <span class="sep">/</span> 
      <span class="current">{data.title}</span>
    </nav>

    <article class="prose">
      <header class="article-header">
        <h1>{data.title}</h1>
      </header>
      
      <div class="article-body" set:html={htmlContent} />
    </article>
  </div>
</MainLayout>

<style>
  /* Стили идентичны RU версии для консистентности */
  .article-container { max-width: 1300px; margin: 60px auto; padding: 0 40px; }
  .breadcrumb { margin-bottom: 25px; font-size: 0.9rem; color: #666; }
  .breadcrumb a { color: #3498db; text-decoration: none; }
  .breadcrumb .sep { margin: 0 10px; opacity: 0.3; }
  .article-header h1 { font-size: 2.8rem; margin-bottom: 12px; color: #fff; }
  .article-body { line-height: 1.7; font-size: 1.10rem; color: #e0e0e0; }
  .article-body :global(h2) { font-size: 1.8rem; margin: 1.5em 0 0.8em; color: #fff; }
  .article-body :global(pre) { background: #0b0b0b; padding: 20px; border-radius: 12px; border: 1px solid #222; overflow-x: auto; }
  .article-body :global(img) { width: 100%; border-radius: 10px; margin: 1.5rem 0; border: 1px solid #333; }
  @media (max-width: 768px) {
    .article-container { margin: 40px auto; padding: 0 20px; }
    .article-body { text-align: left; }
    .article-header h1 { font-size: 2rem; }
  }
</style>
