---
import MainLayout from '../../../../layouts/MainLayout.astro';
import LabCard from '../../../../components/LabCard.astro';
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';

const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base : `${base}/`;
const lang = "en";

export async function getStaticPaths({ paginate }) {
  const labsDir = './src/content/writeups/en';
  if (!fs.existsSync(labsDir)) return [];

  const files = fs.readdirSync(labsDir).filter(f => f.endsWith('.md'));

  const allLabs = files.map(file => {
    const fileContent = fs.readFileSync(path.join(labsDir, file), 'utf-8');
    const { data } = matter(fileContent);
    return {
      slug: file.replace('.md', ''),
      ...data 
    };
  });

  const platforms = ['thm', 'htb']; 

  return platforms.flatMap(platform => {
    const filteredLabs = allLabs
      .filter(lab => lab.platform === platform)
      .sort((a, b) => new Date(b.date || 0).getTime() - new Date(a.date || 0).getTime());

    if (filteredLabs.length === 0) return [];

    return paginate(filteredLabs, {
      params: { platform }, 
      pageSize: 12
    });
  });
}

const { page } = Astro.props;
const { platform } = Astro.params;

const platformTitle = platform === 'thm' ? 'TryHackMe' : 'HackTheBox';

/** * ИСПРАВЛЕНИЕ ПУТЕЙ ПАГИНАЦИИ:
 * Мы берем номер страницы из URL Astro и склеиваем его с правильным префиксом.
 */
const getPageUrl = (url) => {
  if (!url) return null;
  // url обычно приходит в виде "/en/writeups/thm/2" или просто "2"
  // Чтобы не гадать, вытаскиваем только номер страницы в конце
  const parts = url.split('/');
  const pageNum = parts[parts.length - 1];
  return `${cleanBase}${lang}/writeups/${platform}/${pageNum}`;
};

const prevUrl = getPageUrl(page.url.prev);
const nextUrl = getPageUrl(page.url.next);
---

<MainLayout title={`${platformTitle} Writeups`}>
  <div class="container">
    <nav class="breadcrumb">
       <a href={`${cleanBase}${lang}/writeups`}>Writeups</a> / <span>{platformTitle}</span>
    </nav>

    <h1>{platformTitle} Solutions</h1>

    <div class="grid">
      {page.data.map(lab => (
        <LabCard 
          title={lab.title} 
          desc={lab.description} 
          date={lab.date} 
          /* Ссылка на статью */
          url={`${lang}/writeups/${lab.slug}`} 
          image={lab.image}
        />
      ))}
    </div>

    <nav class="pagination">
      {prevUrl ? (
        <a href={prevUrl} class="p-btn">← Back</a>
      ) : (
        <span class="p-btn disabled">← Back</span>
      )}

      <div class="pages">
         {page.currentPage} / {page.lastPage}
      </div>

      {nextUrl ? (
        <a href={nextUrl} class="p-btn">Next →</a>
      ) : (
        <span class="p-btn disabled">Next →</span>
      )}
    </nav>
  </div>
</MainLayout>

<style>
  .container { max-width: 1200px; margin: 60px auto; padding: 0 20px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 40px 25px; }
  .pagination { margin-top: 60px; display: flex; justify-content: center; align-items: center; gap: 20px; }
  .p-btn { padding: 10px 20px; background: #111; border: 1px solid #333; border-radius: 8px; text-decoration: none; color: #fff; min-width: 100px; text-align: center; transition: 0.2s; }
  .p-btn:hover:not(.disabled) { border-color: #3498db; background: #1a1a1a; }
  .p-btn.disabled { opacity: 0.2; cursor: not-allowed; }
  .pages { color: #666; font-family: monospace; min-width: 60px; text-align: center; font-weight: bold; }
  .breadcrumb { margin-bottom: 20px; color: #555; font-size: 0.9rem; }
  .breadcrumb a { color: #3498db; text-decoration: none; }
  h1 { color: #fff; margin-bottom: 40px; font-size: 2.5rem; }
    @media (max-width: 768px) {
    .container {
      margin: 24px auto;
      padding: 0 16px;
    }

    .page-header {
      margin-bottom: 24px;
      padding-bottom: 20px;
    }

    .page-header h1 {
      font-size: 1.4rem;
    }

    .page-header p {
      font-size: 0.9rem;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .pagination {
      margin-top: 36px;
      gap: 10px;
    }

    .p-btn {
      padding: 8px 12px;
      font-size: 0.85rem;
    }
  }
</style>
