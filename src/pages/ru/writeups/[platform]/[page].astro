---
import MainLayout from '../../../../layouts/MainLayout.astro';
import LabCard from '../../../../components/LabCard.astro';
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';

export async function getStaticPaths({ paginate }) {
  const labsDir = './src/content/writeups/ru';
  
  // Если папки нет, не генерируем ничего
  if (!fs.existsSync(labsDir)) return [];

  const files = fs.readdirSync(labsDir).filter(f => f.endsWith('.md'));

  const allLabs = files.map(file => {
    const fileContent = fs.readFileSync(path.join(labsDir, file), 'utf-8');
    const { data } = matter(fileContent);
    return {
      slug: file.replace('.md', ''),
      ...data 
    };
  });

  // Генерируем страницы ТОЛЬКО для этих двух платформ
  const platforms = ['thm', 'htb']; 

  return platforms.flatMap(platform => {
    const filteredLabs = allLabs
      .filter(lab => lab.platform === platform)
      .sort((a, b) => new Date(b.date || 0).getTime() - new Date(a.date || 0).getTime());

    // Если для платформы нет статей, Astro может ругаться, 
    // поэтому проверяем длину массива
    if (filteredLabs.length === 0) return [];

    return paginate(filteredLabs, {
      params: { platform }, 
      pageSize: 12
    });
  });
}

const { page } = Astro.props;
const { platform } = Astro.params;

const platformTitle = platform === 'thm' ? 'TryHackMe' : 'HackTheBox';
---

<MainLayout title={platformTitle}>
  <div class="container">
    <nav class="breadcrumb">
       <a href="/ru/writeups">Writeups</a> / <span>{platformTitle}</span>
    </nav>

    <h1>{platformTitle} Разборы</h1>

<div class="grid">
  {page.data.map(lab => (
    <LabCard 
      title={lab.title} 
      desc={lab.description} 
      date={lab.date} 
      /* УБРАЛИ начальный слэш. Теперь будет один /handson/ */
      url={`${lang}/writeups/${lab.slug}`} 
      image={lab.image}
    />
  ))}
</div>

    <nav class="pagination">
      {page.url.prev && <a href={page.url.prev} class="p-btn">← Назад</a>}
      <div class="pages">{page.currentPage} / {page.lastPage}</div>
      {page.url.next && <a href={page.url.next} class="p-btn">Вперед →</a>}
    </nav>
  </div>
</MainLayout>

<style>
  .container { max-width: 1200px; margin: 60px auto; padding: 0 20px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 30px; }
  .breadcrumb { margin-bottom: 20px; color: #666; }
  .breadcrumb a { color: var(--accent); text-decoration: none; }
  h1 { margin-bottom: 40px; color: #fff; }
  .pagination { display: flex; gap: 20px; align-items: center; margin-top: 40px; }
  .p-btn { padding: 10px 20px; background: #111; border: 1px solid #333; border-radius: 8px; text-decoration: none; color: #fff; }
</style>
