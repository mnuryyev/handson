---
import MainLayout from '../../../../layouts/MainLayout.astro';
import LabCard from '../../../../components/LabCard.astro';
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';

const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base : `${base}/`;
const lang = "ru";

export async function getStaticPaths({ paginate }) {
  const labsDir = './src/content/writeups/ru';
  if (!fs.existsSync(labsDir)) return [];

  const files = fs.readdirSync(labsDir).filter(f => f.endsWith('.md'));

  const allLabs = files.map(file => {
    const fileContent = fs.readFileSync(path.join(labsDir, file), 'utf-8');
    const { data } = matter(fileContent);
    return {
      slug: file.replace('.md', ''),
      ...data 
    };
  });

  const platforms = ['thm', 'htb']; 

  return platforms.flatMap(platform => {
    const filteredLabs = allLabs
      .filter(lab => lab.platform === platform)
      .sort((a, b) => new Date(b.date || 0).getTime() - new Date(a.date || 0).getTime());

    if (filteredLabs.length === 0) return [];

    return paginate(filteredLabs, {
      params: { platform }, 
      pageSize: 12
    });
  });
}

const { page } = Astro.props;
const { platform } = Astro.params;

const platformTitle = platform === 'thm' ? 'TryHackMe' : 'HackTheBox';
---

<MainLayout title={platformTitle}>
  <div class="container">
    <nav class="breadcrumb">
       <a href={`${cleanBase}${lang}/writeups`}>Writeups</a> / <span>{platformTitle}</span>
    </nav>

    <h1>{platformTitle} Разборы</h1>

<div class="grid">
  {page.data.map(lab => (
    <LabCard 
      title={lab.title} 
      desc={lab.description} 
      date={lab.date} 
      /* ИСПРАВЛЕНИЕ: Мы убираем cleanBase и первый слэш. 
         Astro сам подставит /handson/ один раз, 
         так как путь начинается сразу с названия папки 'ru'
      */
      url={`ru/writeups/${lab.slug}`} 
      image={lab.image}
    />
  ))}
</div>

    <nav class="pagination">
      {page.url.prev && <a href={page.url.prev} class="p-btn">← Назад</a>}
      <div class="pages">{page.currentPage} / {page.lastPage}</div>
      {page.url.next && <a href={page.url.next} class="p-btn">Вперед →</a>}
    </nav>
  </div>
</MainLayout>

<style>
  .container { 
    max-width: 1200px; 
    margin: 60px auto; 
    padding: 0 20px; 
  }

  .grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); 
    gap: 30px; 
  }

  .breadcrumb { 
    margin-bottom: 20px; 
    color: #666; 
  }

  .breadcrumb a { 
    color: var(--accent); 
    text-decoration: none; 
  }

  h1 { 
    margin-bottom: 40px; 
    color: #fff; 
  }

  /* --- ИСПРАВЛЕННАЯ ПАГИНАЦИЯ --- */
  .pagination { 
    margin-top: 60px; 
    padding-top: 40px;
    border-top: 1px solid #222;
    display: grid; 
    /* Создаем 3 колонки: боковые делят место поровну (1fr), центр подстраивается под текст */
    grid-template-columns: 1fr auto 1fr; 
    align-items: center; 
    gap: 20px; 
  }

  /* Левая кнопка прижимается влево */
  .pagination a:first-child, 
  .pagination span:first-child {
    justify-self: start;
  }

  /* Правая кнопка прижимается вправо */
  .pagination a:last-child, 
  .pagination span:last-child {
    justify-self: end;
  }

  .pages { 
    grid-column: 2; /* Всегда во второй колонке (центр) */
    color: #666; 
    font-family: monospace;
    font-size: 1.1rem;
    white-space: nowrap;
  }

  .p-btn { 
    padding: 10px 25px; 
    background: #111; 
    border: 1px solid #333; 
    border-radius: 8px; 
    text-decoration: none; 
    color: #fff; 
    transition: 0.3s ease;
    min-width: 110px; /* Фиксированная ширина, чтобы кнопки были одинаковыми */
    text-align: center;
  }

  .p-btn:hover:not(.disabled) {
    background: #1a1a1a;
    border-color: var(--accent, #fff);
  }

  .p-btn.disabled {
    opacity: 0.2;
    cursor: not-allowed;
  }
</style>
