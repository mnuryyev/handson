---
import MainLayout from '../../../../layouts/MainLayout.astro';
import LabCard from '../../../../components/LabCard.astro';
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';

const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base : `${base}/`;
const lang = "ru";

export async function getStaticPaths({ paginate }) {
  const labsDir = './src/content/writeups/ru';
  if (!fs.existsSync(labsDir)) return [];

  const files = fs.readdirSync(labsDir).filter(f => f.endsWith('.md'));

  const allLabs = files.map(file => {
    const fileContent = fs.readFileSync(path.join(labsDir, file), 'utf-8');
    const { data } = matter(fileContent);
    return {
      slug: file.replace('.md', ''),
      ...data 
    };
  });

  const platforms = ['thm', 'htb']; 

  return platforms.flatMap(platform => {
    const filteredLabs = allLabs
      .filter(lab => lab.platform === platform)
      .sort((a, b) => new Date(b.date || 0).getTime() - new Date(a.date || 0).getTime());

    if (filteredLabs.length === 0) return [];

    return paginate(filteredLabs, {
      params: { platform }, 
      pageSize: 12
    });
  });
}

const { page } = Astro.props;
const { platform } = Astro.params;

const platformTitle = platform === 'thm' ? 'TryHackMe' : 'HackTheBox';
---

<MainLayout title={platformTitle}>
  <div class="container">
    <nav class="breadcrumb">
       <a href={`${cleanBase}${lang}/writeups`}>Writeups</a> / <span>{platformTitle}</span>
    </nav>

    <h1>{platformTitle} Разборы</h1>

<div class="grid">
  {page.data.map(lab => (
    <LabCard 
      title={lab.title} 
      desc={lab.description} 
      date={lab.date} 
      /* ИСПРАВЛЕНИЕ: Мы убираем cleanBase и первый слэш. 
         Astro сам подставит /handson/ один раз, 
         так как путь начинается сразу с названия папки 'ru'
      */
      url={`ru/writeups/${lab.slug}`} 
      image={lab.image}
    />
  ))}
</div>
<nav class="pagination">
      {page.url.prev ? (
        <a href={page.url.prev} class="p-btn">← Назад</a>
      ) : (
        <span class="p-btn disabled">← Назад</span>
      )}

      <div class="pages">
         {page.currentPage} / {page.lastPage}
      </div>

      {page.url.next ? (
        <a href={page.url.next} class="p-btn">Вперед →</a>
      ) : (
        <span class="p-btn disabled">Вперед →</span>
      )}
    </nav>
  </div>
</MainLayout>
<style>
  .container { 
    max-width: 1200px; 
    margin: 60px auto; 
    padding: 0 20px; 
  }
  
  .page-header { 
    margin-bottom: 50px; 
    border-bottom: 1px solid #222; 
    padding-bottom: 30px; 
  }
  
  .page-header h1 {
    font-size: 2.5rem;
    margin-bottom: 10px;
    color: #fff;
  }

  .page-header p {
    color: #888;
    font-size: 1.1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 40px 25px;
  }

  /* Пагинация один-в-один как в tools */
  .pagination { 
    margin-top: 60px; 
    display: flex; 
    justify-content: center; 
    align-items: center; 
    gap: 20px; 
  }

  .p-btn { 
    padding: 10px 20px; 
    background: #111; 
    border: 1px solid #333; 
    border-radius: 8px; 
    text-decoration: none; 
    color: #fff; 
    font-size: 0.9rem;
    transition: all 0.2s ease;
    /* Добавляем min-width, чтобы центр не гулял при смене кнопок */
    min-width: 100px;
    text-align: center;
  }

  .p-btn:hover:not(.disabled) { 
    background: #1a1a1a; 
    border-color: var(--accent); 
  }

  .p-btn.disabled { 
    opacity: 0.2; 
    cursor: not-allowed; 
  }

  .pages { 
    color: #666; 
    font-size: 0.95rem; 
    font-weight: 600; 
    font-family: monospace;
    /* Резервируем место под цифры, чтобы кнопки не дергались */
    min-width: 60px;
    text-align: center;
  }

.breadcrumb { 
    margin-bottom: 20px; 
    color: #666; 
    font-size: 0.9rem;
  }

  .breadcrumb a { 
    /* Если --accent не работает, используй конкретный цвет, например #007bff или #444 */
    color: #999; 
    text-decoration: none; 
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover { 
    color: #fff; /* При наведении ссылка станет белой */
    text-decoration: underline; /* Появится подчеркивание */
  }

  .breadcrumb .sep {
    margin: 0 8px;
    color: #444;
  }
</style>
