---
import MainLayout from '../../../layouts/MainLayout.astro';

// Получаем /handson/ из конфига
const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base : `${base}/`;
const lang = "ru";

const platforms = [
  {
    id: 'thm',
    title: 'TryHackMe',
    description: 'Разборы комнат, цепочек и тренировочных машин с платформы THM',
    icon: '/handson/images/neighbour_thm/thm_main.png', 
    color: '#212c42'
  },
  {
    id: 'htb',
    title: 'HackTheBox',
    description: 'Детальные writeup-ы машин и челленджей из лабораторий HTB',
    icon: '/handson/images/meow_htb/htb_main.jpg', 
    color: '#9fe52d'
  }
];
---

<MainLayout title="Writeups - Выбор платформы">
  <div class="container">
    <header class="page-header">
      <h1>🎯 Выберите платформу</h1>
      <p>Все отчеты структурированы по тренировочным площадкам</p>
    </header>

    <div class="platform-grid">
      {platforms.map(platform => (
        /* Склеиваем /handson/ + ru/writeups/... */
        <a href={`${cleanBase}${lang}/writeups/${platform.id}/1`} class={`platform-card ${platform.id}`}>
          <div class="card-inner">
            <div class="icon-box">
              <img src={platform.icon} alt={platform.title} />
            </div>
            <div class="text-box">
              <h2>{platform.title}</h2>
              <p>{platform.description}</p>
            </div>
            <div class="arrow">→</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</MainLayout>

<style>
  .container { max-width: 1100px; margin: 80px auto; padding: 0 20px; }
  .page-header { margin-bottom: 60px; text-align: left; }
  .page-header h1 { font-size: 3rem; color: #fff; }
  .page-header p { color: #888; font-size: 1.2rem; }
  .platform-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 30px; }
  .platform-card {
    text-decoration: none;
    background: #0d0d0d;
    border: 1px solid #222;
    border-radius: 24px;
    padding: 40px;
    position: relative;
    transition: all 0.4s ease;
  }
  .platform-card:hover { transform: translateY(-8px); border-color: #444; background: #111; }
  .icon-box { margin-bottom: 30px; }
  .icon-box img { height: 60px; min-width: 60px; width: auto; }
  .text-box h2 { color: #fff; font-size: 2rem; margin-bottom: 12px; }
  .text-box p { color: #777; line-height: 1.6; }
  .arrow { position: absolute; bottom: 40px; right: 40px; color: #333; font-size: 2rem; }
  .platform-card:hover .arrow { color: #fff; transform: translateX(5px); }
  .thm:hover { border-color: #212c42; }
  .htb:hover { border-color: #9fe52d; }
</style>
