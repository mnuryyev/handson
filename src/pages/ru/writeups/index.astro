---
import MainLayout from '../../../layouts/MainLayout.astro';

// Получаем /handson/ из конфига
const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base : `${base}/`;
const lang = "ru";

const platforms = [
  {
    id: 'thm',
    title: 'TryHackMe',
    description: 'Разборы комнат, цепочек и тренировочных машин с платформы THM',
    icon: '/handson/images/neighbour_thm/thm_main.png', 
    color: '#сс2929'
  },
  {
    id: 'htb',
    title: 'HackTheBox',
    description: 'Детальные writeup-ы машин и челленджей из лабораторий HTB',
    icon: '/handson/images/meow_htb/htb_main.jpg', 
    color: '#9fe52d'
  }
];
---

<MainLayout title="Writeups - Выбор платформы">
  <div class="container">
    <header class="page-header">
      <h1>🎯 Практика и разборы</h1>
      <p>Решения задач, writeups и заметки по пентесту и защите систем</p>
    </header>

    <div class="platform-grid">
      {platforms.map(platform => (
        /* Склеиваем /handson/ + ru/writeups/... */
        <a href={`${cleanBase}${lang}/writeups/${platform.id}/1`} class={`platform-card ${platform.id}`}>
          <div class="card-inner">
            <div class="icon-box">
              <img src={platform.icon} alt={platform.title} />
            </div>
            <div class="text-box">
              <h2>{platform.title}</h2>
              <p>{platform.description}</p>
            </div>
            <div class="arrow">→</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</MainLayout>

<style>
  .container { 
    max-width: 1100px; 
    margin: 40px auto; 
    padding: 0 20px; 
    /* Добавляем, чтобы контейнер сам не создавал скролл */
    width: 100%;
    overflow: hidden; 
  }
  
  .page-header { margin-bottom: 40px; text-align: center; } /* Центрируем заголовок на мобилках */
  .page-header h1 { font-size: 1.8rem; color: #fff; margin-bottom: 10px; }
  .page-header p { color: #ccc; }
  
  .platform-grid { 
    display: grid; 
    /* ИСПРАВЛЕНИЕ: minmax делаем меньше (например 280px), чтобы влезало на любой телефон */
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); 
    gap: 25px; 
    justify-content: center; /* Центрирует карточки, если их мало в ряду */
  }
  
  .platform-card {
    text-decoration: none;
    background: #0d0d0d;
    border: 1px solid #222;
    border-radius: 20px;
    padding-bottom: 30px; 
    position: relative;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    width: 100%; /* Карточка занимает всю ширину колонки */
  }
  
  .platform-card:hover { 
    transform: translateY(-5px); 
    border-color: #333; 
    background: #111; 
  }

  .icon-box { 
    width: 100%; 
    height: 180px; 
    display: flex; 
    align-items: center; 
    justify-content: center;
    margin-bottom: 20px; 
    position: relative;
    overflow: hidden;
    background: #050505;
  }

  .icon-box img { 
    width: 100%; 
    height: 100%; 
    object-fit: cover; 
    filter: brightness(0.7); 
    transition: all 0.4s ease;
  }
  
  .platform-card:hover .icon-box img {
    filter: brightness(1);
    transform: scale(1.05);
  }

  .text-box { 
    padding: 0 25px; /* Чуть уменьшили отступы для мобилок */
  }

  .text-box h2 { 
    color: #fff; 
    font-size: 1.5rem; 
    margin-bottom: 10px; 
  }

  .text-box p { 
    color: #aaa;
    font-size: 0.95rem;
    margin-bottom: 20px;
    line-height: 1.4;
  }
  
  .arrow { 
    display: none; /* На мобилках стрелка часто мешает тексту, можно скрыть или оставить */
  }

  /* Цвета платформ */
  .thm .icon-box { border-bottom: 3px solid #cc2929; }
  .htb .icon-box { border-bottom: 3px solid #9fe52d; }

  /* ПРАВКИ ДЛЯ МОБИЛОК */
  @media (max-width: 768px) {
    .container { margin: 20px auto; }
    .platform-grid { gap: 20px; }
    .page-header h1 { font-size: 1.5rem; }
  }

  @media (max-width: 480px) {
    .icon-box { height: 150px; }
    .text-box h2 { font-size: 1.3rem; }
    .text-box p { margin-right: 0; } /* Убираем лишний отступ справа */
  }
</style>
