---
import MainLayout from '../../../layouts/MainLayout.astro';

// Получаем /handson/ из конфига
const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base : `${base}/`;
const lang = "ru";

const platforms = [
  {
    id: 'thm',
    title: 'TryHackMe',
    description: 'Разборы комнат, цепочек и тренировочных машин с платформы THM',
    icon: '/handson/images/neighbour_thm/thm_main.png', 
    color: '#сс2929'
  },
  {
    id: 'htb',
    title: 'HackTheBox',
    description: 'Детальные writeup-ы машин и челленджей из лабораторий HTB',
    icon: '/handson/images/meow_htb/htb_main.jpg', 
    color: '#9fe52d'
  }
];
---

<MainLayout title="Writeups - Выбор платформы">
  <div class="container">
    <header class="page-header">
      <h1>🎯 Выберите платформу</h1>
      <p>Все отчеты структурированы по тренировочным площадкам</p>
    </header>

    <div class="platform-grid">
      {platforms.map(platform => (
        /* Склеиваем /handson/ + ru/writeups/... */
        <a href={`${cleanBase}${lang}/writeups/${platform.id}/1`} class={`platform-card ${platform.id}`}>
          <div class="card-inner">
            <div class="icon-box">
              <img src={platform.icon} alt={platform.title} />
            </div>
            <div class="text-box">
              <h2>{platform.title}</h2>
              <p>{platform.description}</p>
            </div>
            <div class="arrow">→</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</MainLayout>

<style>
  .container { max-width: 1100px; margin: 80px auto; padding: 0 20px; }
  .page-header { margin-bottom: 60px; text-align: left; }
  .page-header h1 { font-size: 3rem; color: #fff; margin-bottom: 10px; }
  .page-header p { color: #888; font-size: 1.2rem; }
  
  .platform-grid { 
    display: grid; 
    /* Немного уменьшим minmax, чтобы на мобильных было лучше */
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); 
    gap: 30px; 
  }
  
  .platform-card {
    text-decoration: none;
    background: #0d0d0d;
    border: 1px solid #222;
    border-radius: 24px;
    /* --- ВАЖНО: УБРАЛИ PADDING ОТСЮДА --- */
    padding: 0; 
    position: relative;
    overflow: hidden; /* Чтобы картинка не вылезала за скругленные края */
    transition: all 0.4s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  
  .platform-card:hover { 
    transform: translateY(-8px); 
    border-color: #444; 
    background: #111; 
  }

  /* --- НОВЫЙ БЛОК ИКОНКИ (БАННЕР) --- */
  .icon-box { 
    width: 100%; 
    height: 160px; /* Увеличили высоту для эффекта баннера */
    display: flex; 
    align-items: center; 
    justify-content: center;
    /* У каждой платформы будет свой фон (см. ниже .thm / .htb) */
    position: relative;
    overflow: hidden;
  }

  .icon-box img { 
    /* Картинка занимает 100% места в .icon-box */
    width: 100%; 
    height: 100%; 
    
    /* object-fit: cover — СЕКРЕТНЫЙ ИНГРЕДИЕНТ для заполнения.
       Он масштабирует картинку, чтобы она полностью заполнила блок, 
       обрезая лишнее. Логотип будет большим и во всю ширину.
    */
    object-fit: cover; 
    
    display: block;
    /* Немного затемним картинку, чтобы текст под ней читался лучше */
    filter: brightness(0.8) contrast(1.1); 
    transition: filter 0.3s ease;
  }
  
  .platform-card:hover .icon-box img {
    filter: brightness(1) contrast(1.1); /* При наведении делаем ярче */
  }

  /* --- НОВЫЙ БЛОК ТЕКСТА --- */
  .text-box { 
    padding: 30px 40px 40px; /* Добавили отступы тексту */
    flex-grow: 1; /* Чтобы текст занимал всё оставшееся место */
    display: flex;
    flex-direction: column;
  }

  .text-box h2 { color: #fff; font-size: 2rem; margin-bottom: 12px; }
  .text-box p { color: #777; line-height: 1.6; margin-bottom: 20px; font-size: 1.05rem; }
  
  /* Стрелка теперь внутри .text-box, чтобы не прыгала */
  .arrow { 
    align-self: flex-start; /* Прижимаем влево */
    color: #333; 
    font-size: 2rem; 
    transition: 0.3s; 
    margin-top: auto; /* Толкаем стрелку вниз */
  }
  .platform-card:hover .arrow { color: #fff; transform: translateX(5px); }
  
  /* Уникальные стили для каждой платформы */
  .thm .icon-box { background: rgba(33, 44, 66, 0.2); } /* Фон баннера THM */
  .htb .icon-box { background: rgba(159, 229, 45, 0.1); } /* Фон баннера HTB */
  
  .thm:hover { border-color: #212c42; box-shadow: 0 10px 40px -10px rgba(33, 44, 66, 0.4); }
  .htb:hover { border-color: #9fe52d; box-shadow: 0 10px 40px -10px rgba(159, 229, 45, 0.2); }

  @media (max-width: 768px) {
    .platform-grid { grid-template-columns: 1fr; }
    .page-header h1 { font-size: 2.2rem; }
    .icon-box { height: 120px; } /* Чуть меньше на мобильных */
    .text-box { padding: 25px 30px 30px; }
  }
</style>
