---
import MainLayout from '../../../layouts/MainLayout.astro';

// Получаем /handson/ из конфига
const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base : `${base}/`;
const lang = "ru";

const platforms = [
  {
    id: 'thm',
    title: 'TryHackMe',
    description: 'Разборы комнат, цепочек и тренировочных машин с платформы THM',
    icon: '/handson/images/neighbour_thm/thm_main.png', 
    color: '#сс2929'
  },
  {
    id: 'htb',
    title: 'HackTheBox',
    description: 'Детальные writeup-ы машин и челленджей из лабораторий HTB',
    icon: '/handson/images/meow_htb/htb_main.jpg', 
    color: '#9fe52d'
  }
];
---

<MainLayout title="Writeups - Выбор платформы">
  <div class="container">
    <header class="page-header">
      <h1>🎯 Выберите платформу</h1>
      <p>Все отчеты структурированы по тренировочным площадкам</p>
    </header>

    <div class="platform-grid">
      {platforms.map(platform => (
        /* Склеиваем /handson/ + ru/writeups/... */
        <a href={`${cleanBase}${lang}/writeups/${platform.id}/1`} class={`platform-card ${platform.id}`}>
          <div class="card-inner">
            <div class="icon-box">
              <img src={platform.icon} alt={platform.title} />
            </div>
            <div class="text-box">
              <h2>{platform.title}</h2>
              <p>{platform.description}</p>
            </div>
            <div class="arrow">→</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</MainLayout>

<style>
  .container { max-width: 1100px; margin: 60px auto; padding: 0 20px; }
  .page-header { margin-bottom: 50px; }
  .page-header h1 { font-size: 2.5rem; color: #fff; margin-bottom: 10px; }
  .page-header p { color: #666; font-size: 1.1rem; }
  
  .platform-grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); 
    gap: 30px; 
  }
  
  .platform-card {
    text-decoration: none;
    background: #0d0d0d;
    border: 1px solid #222;
    border-radius: 20px;
    /* --- ВАЖНО: Убрали верхний и боковые padding --- */
    padding: 0 0 35px 0; 
    position: relative;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    overflow: hidden; /* Скрываем лишнее, если картинка больше */
  }
  
  .platform-card:hover { 
    transform: translateY(-5px); 
    border-color: #333; 
    background: #111; 
  }

  /* --- НОВЫЙ БЛОК ИКОНКИ (БАННЕР НА ВСЮ ШИРИНУ) --- */
  .icon-box { 
    width: 100%; 
    height: 100px; /* Фиксированная высота баннера */
    display: flex; 
    align-items: center; 
    justify-content: center;
    margin-bottom: 25px; /* Отступ от баннера до текста */
    position: relative;
    overflow: hidden;
  }

  .icon-box img { 
    /* Картинка растягивается на всю ширину .icon-box */
    width: 100%; 
    height: 100%; 
    
    /* object-fit: cover — СЕКРЕТНЫЙ ИНГРЕДИЕНТ для заполнения.
       Он масштабирует картинку, чтобы она полностью заполнила блок, 
       обрезая лишнее. Логотип будет большим и во всю ширину.
    */
    object-fit: cover; 
    
    display: block;
    /* Немного затемним картинку, чтобы она не была слишком яркой */
    filter: brightness(0.9); 
    transition: filter 0.3s ease;
  }
  
  .platform-card:hover .icon-box img {
    filter: brightness(1); /* При наведении делаем ярче */
  }

  /* --- НОВЫЙ БЛОК ТЕКСТА С ОТСТУПАМИ --- */
  .text-box { 
    padding: 0 35px; /* Добавили боковые отступы тексту */
    flex-grow: 1; /* Чтобы текст занимал всё оставшееся место */
  }

  .text-box h2 { 
    color: #fff; 
    font-size: 1.7rem; /* Чуть увеличили шрифт заголовка */
    margin-bottom: 12px; 
  }

  .text-box p { 
    color: #777; 
    line-height: 1.5; 
    font-size: 1rem; 
    margin-right: 40px; /* Отступ справа, чтобы текст не налезал на стрелку */
    margin-bottom: 15px; /* Отступ снизу */
  }
  
  /* Стрелка в углу */
  .arrow { 
    position: absolute;
    bottom: 35px; 
    right: 35px;
    color: #333; /* По умолчанию стрелка темная */
    font-size: 1.8rem; 
    transition: all 0.3s ease; 
  }
  
  .platform-card:hover .arrow { 
    color: #fff; /* При наведении становится белой */
    transform: translateX(5px); 
  }
  
  /* Уникальные фоны для каждой платформы */
  .thm .icon-box { background: rgba(33, 44, 66, 0.4); } /* Фон баннера THM */
  .htb .icon-box { background: rgba(159, 229, 45, 0.2); } /* Фон баннера HTB */
  
  /* Акценты при наведении */
  .thm:hover { border-color: #cc2929; box-shadow: 0 10px 30px -10px rgba(33, 44, 66, 0.3); }
  .htb:hover { border-color: #9fe52d; box-shadow: 0 10px 30px -10px rgba(159, 229, 45, 0.1); }

  @media (max-width: 480px) {
    .platform-card { padding: 0 0 25px 0; }
    .text-box { padding: 0 25px; }
    .text-box h2 { font-size: 1.5rem; }
    .arrow { bottom: 25px; right: 25px; }
    .icon-box { height: 80px; } /* Чуть меньше на мобильных */
  }
</style>
