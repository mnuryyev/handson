---
import MainLayout from '../../../layouts/MainLayout.astro';

const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base : `${base}/`;
const lang = "ru";

const platforms = [
  {
    id: 'thm',
    title: 'TryHackMe',
    description: 'Разборы комнат, цепочек и тренировочных машин с платформы THM',
    icon: '/handson/images/neighbour_thm/thm_main.png', 
    color: '#cc2929'
  },
  {
    id: 'htb',
    title: 'HackTheBox',
    description: 'Детальные writeup-ы машин и челленджей из лабораторий HTB',
    icon: '/handson/images/meow_htb/htb_main.jpg', 
    color: '#9fe52d'
  }
];
---

<MainLayout title="Writeups - Выбор платформы">
  <div class="container">
    <header class="page-header">
      <div class="header-label">Раздел</div>
      <h1>🎯 Практика и разборы</h1>
      <p>Решения задач, writeups и заметки по пентесту и защите систем</p>
    </header>

    <div class="platform-grid">
      {platforms.map(platform => (
        <a href={`${cleanBase}${lang}/writeups/${platform.id}/1`} class={`platform-card ${platform.id}`}>
          <div class="icon-box">
            <img src={platform.icon} alt={platform.title} />
          </div>
          <div class="text-box">
            <h2>{platform.title}</h2>
            <p>{platform.description}</p>
          </div>
          <div class="arrow">→</div>
        </a>
      ))}
    </div>
  </div>
</MainLayout>

<style>
  .container { max-width: 1300px; margin: 0 auto; padding: 52px 24px 80px; width: 100%; }

  .page-header {
    margin-bottom: 44px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }

  .header-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--accent); margin-bottom: 10px; }
  .page-header h1 { font-size: 1.9rem; font-weight: 800; color: #fff; margin: 0 0 10px; letter-spacing: -0.5px; }
  .page-header p { color: var(--text-2); margin: 0; font-size: 0.95rem; }

  .platform-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }

  .platform-card {
    text-decoration: none !important;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding-bottom: 48px;
    position: relative;
    transition: all 0.22s ease;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .platform-card:hover {
    text-decoration: none !important;
    transform: translateY(-5px);
    border-color: rgba(62, 166, 255, 0.3);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
  }

  .icon-box {
    width: 100%;
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background: rgba(255,255,255,0.02);
  }

  .icon-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.65) saturate(0.9);
    transition: all 0.4s ease;
  }

  .platform-card:hover .icon-box img {
    filter: brightness(0.9) saturate(1);
    transform: scale(1.04);
  }

  .text-box { padding: 20px 22px 0; }
  .text-box h2 { color: #fff; font-size: 1.3rem; font-weight: 700; margin: 0 0 8px; }
  .text-box p { color: var(--text-2); font-size: 0.875rem; line-height: 1.55; margin: 0; }

  .arrow {
    position: absolute;
    bottom: 20px;
    right: 22px;
    color: var(--text-3);
    font-size: 1.2rem;
    transition: all 0.22s ease;
  }

  .platform-card:hover .arrow { color: var(--accent); transform: translateX(4px); }

  .thm .icon-box { border-bottom: 2px solid rgba(204, 41, 41, 0.5); }
  .htb .icon-box { border-bottom: 2px solid rgba(159, 229, 45, 0.4); }

  @media (max-width: 768px) {
    .container { padding: 28px 16px 60px; }
    .page-header h1 { font-size: 1.45rem; }
    .platform-grid { grid-template-columns: 1fr; }
    .icon-box { height: 150px; }
  }
</style>
