---
import MainLayout from '../../../layouts/MainLayout.astro';

// Получаем /handson/ из конфига
const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base : `${base}/`;
const lang = "ru";

const platforms = [
  {
    id: 'thm',
    title: 'TryHackMe',
    description: 'Разборы комнат, цепочек и тренировочных машин с платформы THM',
    icon: '/handson/images/neighbour_thm/thm_main.png', 
    color: '#сс2929'
  },
  {
    id: 'htb',
    title: 'HackTheBox',
    description: 'Детальные writeup-ы машин и челленджей из лабораторий HTB',
    icon: '/handson/images/meow_htb/htb_main.jpg', 
    color: '#9fe52d'
  }
];
---

<MainLayout title="Writeups - Выбор платформы">
  <div class="container">
    <header class="page-header">
      <h1>🎯 Практика и разборы</h1>
      <p>Решения задач, writeups и заметки по пентесту и защите систем</p>
    </header>

    <div class="platform-grid">
      {platforms.map(platform => (
        /* Склеиваем /handson/ + ru/writeups/... */
        <a href={`${cleanBase}${lang}/writeups/${platform.id}/1`} class={`platform-card ${platform.id}`}>
          <div class="card-inner">
            <div class="icon-box">
              <img src={platform.icon} alt={platform.title} />
            </div>
            <div class="text-box">
              <h2>{platform.title}</h2>
              <p>{platform.description}</p>
            </div>
            <div class="arrow">→</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</MainLayout>

<style>
  .container { max-width: 1100px; margin: 60px auto; padding: 0 20px; }
  .page-header { margin-bottom: 50px; }
  .page-header h1 { font-size: 1.5rem; color: #fff; margin-bottom: 10px; }
  .page-header p { color: #fff; }
  
  .platform-grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); 
    gap: 30px; 
  }
  
  .platform-card {
    text-decoration: none;
    background: #0d0d0d;
    border: 1px solid #222;
    border-radius: 20px;
    padding: 0 0 35px 0; 
    position: relative;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    overflow: hidden; 
  }
  
  .platform-card:hover { 
    transform: translateY(-5px); 
    border-color: #333; 
    background: #111; 
  }

  /* --- УВЕЛИЧИЛИ ВЫСОТУ ТУТ --- */
  .icon-box { 
    width: 100%; 
    height: 180px; /* Было 100px, теперь 180px — картинка станет намного выше */
    display: flex; 
    align-items: center; 
    justify-content: center;
    margin-bottom: 25px; 
    position: relative;
    overflow: hidden;
    /* Можно добавить фоновый градиент, чтобы логотип смотрелся объемнее */
    background: linear-gradient(45deg, #0f0f0f, #1a1a1a);
  }

  .icon-box img { 
    width: 100%; 
    height: 100%; 
    object-fit: cover; /* Заполняет всё пространство 180px */
    display: block;
    filter: brightness(0.85); 
    transition: all 0.4s ease;
  }
  
  .platform-card:hover .icon-box img {
    filter: brightness(1.05);
    transform: scale(1.05); /* Легкий эффект приближения при наведении */
  }

  .text-box { 
    padding: 0 35px; 
  }

  .text-box h2 { 
    color: #fff; 
    font-size: 1.7rem; 
    margin-bottom: 12px; 
  }

  .text-box p { 
    color: #fff;
    margin-right: 45px; 
  }
  
  .arrow { 
    position: absolute;
    bottom: 35px; 
    right: 35px;
    color: #444; 
    font-size: 1.8rem; 
    transition: all 0.3s ease; 
  }
  
  .platform-card:hover .arrow { 
    color: #fff; 
    transform: translateX(5px); 
  }
  
  /* Цвета платформ для фонов, если картинка не на весь экран */
  .thm .icon-box { border-bottom: 2px solid #cc2929; }
  .htb .icon-box { border-bottom: 2px solid #9fe52d; }

@media (max-width: 768px) {
    .container { margin: 20px auto; }
    .platform-grid { gap: 20px; }
    .page-header h1 { font-size: 1.5rem; }
  }

  @media (max-width: 480px) {
    .icon-box { height: 150px; }
    .text-box h2 { font-size: 1.3rem; }
    .text-box p { margin-right: 0; } /* Убираем лишний отступ справа */
  }
</style>
