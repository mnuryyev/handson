---
import MainLayout from '../../../layouts/MainLayout.astro';

// Получаем /handson/ из конфига
const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base : `${base}/`;
const lang = "ru";

const platforms = [
  {
    id: 'thm',
    title: 'TryHackMe',
    description: 'Разборы комнат, цепочек и тренировочных машин с платформы THM',
    icon: '/handson/images/neighbour_thm/thm_main.png', 
    color: '#сс2929'
  },
  {
    id: 'htb',
    title: 'HackTheBox',
    description: 'Детальные writeup-ы машин и челленджей из лабораторий HTB',
    icon: '/handson/images/meow_htb/htb_main.jpg', 
    color: '#9fe52d'
  }
];
---

<MainLayout title="Writeups - Выбор платформы">
  <div class="container">
    <header class="page-header">
      <h1>🎯 Выберите платформу</h1>
      <p>Все отчеты структурированы по тренировочным площадкам</p>
    </header>

    <div class="platform-grid">
      {platforms.map(platform => (
        /* Склеиваем /handson/ + ru/writeups/... */
        <a href={`${cleanBase}${lang}/writeups/${platform.id}/1`} class={`platform-card ${platform.id}`}>
          <div class="card-inner">
            <div class="icon-box">
              <img src={platform.icon} alt={platform.title} />
            </div>
            <div class="text-box">
              <h2>{platform.title}</h2>
              <p>{platform.description}</p>
            </div>
            <div class="arrow">→</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</MainLayout>

<style>
  .container { max-width: 1100px; margin: 60px auto; padding: 0 20px; }
  .page-header { margin-bottom: 50px; }
  .page-header h1 { font-size: 2.5rem; color: #fff; margin-bottom: 10px; }
  .page-header p { color: #666; font-size: 1.1rem; }
  
  .platform-grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); 
    gap: 25px; 
  }
  
  .platform-card {
    text-decoration: none;
    background: #0d0d0d;
    border: 1px solid #222;
    border-radius: 20px;
    padding: 35px; /* Вернули общий отступ */
    position: relative;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }
  
  .platform-card:hover { 
    transform: translateY(-5px); 
    border-color: #333; 
    background: #111; 
  }

  .icon-box { 
    width: 100%; 
    height: 80px; /* Оптимальная высота для логотипа */
    display: flex; 
    align-items: center; 
    margin-bottom: 25px;
  }

  .icon-box img { 
    height: 100%; 
    width: auto; 
    max-width: 180px; /* Ограничили ширину, чтобы не гигантское было */
    object-fit: contain; 
    display: block;
  }

  .text-box h2 { 
    color: #fff; 
    font-size: 1.6rem; /* Уменьшили шрифт заголовка */
    margin-bottom: 10px; 
  }

  .text-box p { 
    color: #777; 
    line-height: 1.5; 
    font-size: 1rem; 
    margin-right: 40px; /* Отступ справа, чтобы текст не налезал на стрелку */
  }
  
  /* Стрелка строго в углу */
  .arrow { 
    position: absolute;
    bottom: 35px; 
    right: 35px;
    color: #444; 
    font-size: 1.8rem; 
    transition: all 0.3s ease; 
  }
  
  .platform-card:hover .arrow { 
    color: #fff; 
    transform: translateX(5px); 
  }
  
  /* Акценты при наведении */
  .thm:hover { border-color: #сс2929; }
  .htb:hover { border-color: #9fe52d; }

  @media (max-width: 480px) {
    .platform-card { padding: 25px; }
    .text-box h2 { font-size: 1.4rem; }
    .arrow { bottom: 25px; right: 25px; }
  }
</style>
