---
import { getCollection } from 'astro:content';
import WikiLayout from '../../../layouts/WikiLayout.astro';

// Получаем все данные для сайдбара
const allEntries = await getCollection('wiki');
const currentSlug = ""; // На главной нет активного файла

// Логика дерева (такая же, как в slug.astro)
const tree = {};
allEntries.forEach(item => {
  const cleanId = item.id.replace(/\.md$/, '');
  const parts = cleanId.split('/');
  let current = tree;
  parts.forEach((part, index) => {
    if (!current[part]) {
      current[part] = index === parts.length - 1 
        ? { type: 'file', item, slug: cleanId } 
        : { type: 'folder', children: {} };
    }
    if (current[part].type === 'folder') current = current[part].children;
  });
});
---

<WikiLayout title="База знаний">
  <div slot="sidebar" class="wiki-tree">
    {Object.entries(tree).map(([name, node]) => (
        <div class="tree-node">
          {node.type === 'folder' ? (
            <details>
              <summary>📂 {name}</summary>
              <div class="folder-content">
                {Object.entries(node.children).map(([childName, childNode]) => (
                  <a href={`/handson/ru/wiki/${childNode.slug}`} class="file-link">
                    📄 {childNode.item.data.title || childName}
                  </a>
                ))}
              </div>
            </details>
          ) : (
            <a href={`/handson/ru/wiki/${node.slug}`} class="file-link">
              📄 {node.item.data.title || name}
            </a>
          )}
        </div>
    ))}
  </div>

  <div class="empty-wiki">
    <div class="obsidian-welcome">
      <span>🌑</span>
      <h2>Выберите заметку</h2>
      <p>Используйте дерево файлов слева, чтобы начать изучение материалов.</p>
    </div>
  </div>
</WikiLayout>

<style>
  /* Те же стили, что в slug.astro */
  .empty-wiki {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 60vh;
    text-align: center;
    color: #444;
  }
  .obsidian-welcome span { font-size: 3rem; display: block; margin-bottom: 20px; opacity: 0.3; }
  .obsidian-welcome h2 { color: #888; margin-bottom: 10px; }
</style>
