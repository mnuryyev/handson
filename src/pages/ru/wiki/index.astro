---
import { getCollection } from 'astro:content';
import WikiLayout from '../../../layouts/WikiLayout.astro';

const allEntries = await getCollection('wiki');

// Логика дерева
const tree = {};
allEntries.forEach(item => {
  const cleanId = item.id.replace(/\.md$/, '');
  const parts = cleanId.split('/');
  let current = tree;
  parts.forEach((part, index) => {
    if (!current[part]) {
      current[part] = index === parts.length - 1 
        ? { type: 'file', item, slug: cleanId } 
        : { type: 'folder', children: {} };
    }
    if (current[part].type === 'folder') current = current[part].children;
  });
});
---

<WikiLayout title="Wiki" headings={[]}>
  <div slot="sidebar" class="wiki-tree">
    {Object.entries(tree).map(([name, node]) => (
      <div class="tree-node">
        {node.type === 'folder' ? (
          <details>
            <summary>📂 {name}</summary>
            <div class="folder-content">
              {Object.entries(node.children).map(([childName, childNode]) => (
                <a href={`/handson/ru/wiki/${childNode.slug}`} class="file-link">
                  📄 {childNode.item.data.title || childName}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a href={`/handson/ru/wiki/${node.slug}`} class="file-link">
            📄 {node.item.data.title || name}
          </a>
        )}
      </div>
    ))}
  </div>

  <div class="obsidian-style-empty">
    <div class="welcome-box">
      <span>🚀</span>
      <h2>База знаний готова</h2>
      <p>Выберите нужный раздел в меню слева, чтобы просмотреть материалы.</p>
    </div>
  </div>
</WikiLayout>

<style>
  .obsidian-style-empty { height: 100%; display: flex; align-items: center; justify-content: center; }
  .welcome-box { text-align: center; color: #555; }
  .welcome-box span { font-size: 3rem; opacity: 0.2; }
  
  /* Стили сайдбара такие же как в slug для единства */
  .wiki-tree { display: flex; flex-direction: column; gap: 2px; }
  summary { list-style: none; padding: 4px 8px; cursor: pointer; color: #888; font-size: 0.85rem; border-radius: 4px; }
  .folder-content { margin-left: 12px; border-left: 1px solid #222; }
  .file-link { display: block; padding: 4px 12px; color: #666; text-decoration: none; font-size: 0.85rem; }
  .file-link:hover { color: #fff; background: #111; }
</style>
