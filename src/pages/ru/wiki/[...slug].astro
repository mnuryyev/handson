---
import { getCollection, render } from 'astro:content';
import WikiLayout from '../../../layouts/WikiLayout.astro';
import WikiTree from '../../../components/WikiTree.astro'; // Импорт

export async function getStaticPaths() {
  const wikiEntries = await getCollection('wiki');
  return wikiEntries.map(entry => ({
    params: { slug: entry.id.replace(/\.md$/, '') }, 
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const allEntries = await getCollection('wiki');
const currentSlug = Astro.params.slug || '';

// 1. Построение дерева любой вложенности
function buildTree(entries) {
  const tree = {};
  entries.forEach(item => {
    const cleanId = item.id.replace(/\.md$/, '');
    const parts = cleanId.split('/');
    let current = tree;

    parts.forEach((part, index) => {
      if (!current[part]) {
        if (index === parts.length - 1) {
          current[part] = { type: 'file', title: item.data?.title || part, slug: cleanId };
        } else {
          current[part] = { type: 'folder', children: {} };
        }
      }
      if (current[part].type === 'folder') {
        current = current[part].children;
      }
    });
  });
  return tree;
}

const fileTree = buildTree(allEntries);
---

<WikiLayout title={entry.data.title} headings={headings}>
  <div slot="sidebar" class="wiki-tree">
  <WikiTree tree={fileTree} currentSlug={currentSlug} />
    {/* Рендерим первый уровень */}
    {Object.entries(fileTree).map(([name, node]) => (
      <div class="tree-node">
        {node.type === 'folder' ? (
          <details open={currentSlug.startsWith(name)}>
            <summary>📂 {name}</summary>
            <div class="folder-content">
              {Object.entries(node.children).map(([childName, childNode]) => (
                <a href={`/handson/ru/wiki/${childNode.slug}`} 
                   class={`file-link ${currentSlug === childNode.slug ? 'active' : ''}`}>
                  📄 {childNode.title || childName}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a href={`/handson/ru/wiki/${node.slug}`} 
             class={`file-link ${currentSlug === node.slug ? 'active' : ''}`}>
            📄 {node.title || name}
          </a>
        )}
      </div>
    ))}
  </div>

  <Content />
</WikiLayout>

<style>
  .wiki-tree { display: flex; flex-direction: column; gap: 2px; }
  summary {
    list-style: none;
    padding: 6px 10px;
    cursor: pointer;
    color: #888;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 8px;
    border-radius: 4px;
  }
  summary:hover { background: #1a1a1a; color: #eee; }
  summary::-webkit-details-marker { display: none; }

  .folder-content {
    margin-left: 14px;
    border-left: 1px solid #222;
    padding-left: 4px;
    display: flex;
    flex-direction: column;
  }

  .file-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    color: #666;
    text-decoration: none;
    font-size: 0.85rem;
    border-radius: 4px;
  }
  .file-link:hover { background: #1a1a1a; color: #fff; }
  .file-link.active {
    background: rgba(52, 152, 219, 0.1);
    color: #3498db;
    font-weight: 500;
  }
</style>
