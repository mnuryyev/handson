---
import { getCollection, render } from 'astro:content';
import WikiLayout from '../../../layouts/WikiLayout.astro';

export async function getStaticPaths() {
  const wikiEntries = await getCollection('wiki');
  return wikiEntries.map(entry => ({
    params: { slug: entry.id.replace(/\.md$/, '') }, 
    props: { entry },
  }));
}

const { entry } = Astro.props;
// Если мы на главной wiki, entry может быть undefined
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;

const allEntries = await getCollection('wiki');
const currentSlug = Astro.params.slug || '';

// Построение дерева
const tree = {};
allEntries.forEach(item => {
  const cleanId = item.id.replace(/\.md$/, '');
  const parts = cleanId.split('/');
  let current = tree;
  parts.forEach((part, index) => {
    if (!current[part]) {
      current[part] = index === parts.length - 1 
        ? { type: 'file', item, slug: cleanId } 
        : { type: 'folder', children: {} };
    }
    if (current[part].type === 'folder') current = current[part].children;
  });
});
---

<WikiLayout title={entry?.data.title || "Wiki"}>
  <div slot="sidebar" class="wiki-tree">
    {Object.entries(tree).map(([name, node]) => (
      <div class="tree-node">
        {node.type === 'folder' ? (
          <details open={currentSlug.startsWith(name)}>
            <summary>📂 {name}</summary>
            <div class="folder-content">
              {Object.entries(node.children).map(([childName, childNode]) => (
                <a href={`/handson/ru/wiki/${childNode.slug}`} 
                   class={`file-link ${currentSlug === childNode.slug ? 'active' : ''}`}>
                  📄 {childNode.item.data.title || childName}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a href={`/handson/ru/wiki/${node.slug}`} 
             class={`file-link ${currentSlug === node.slug ? 'active' : ''}`}>
            📄 {node.item.data.title || name}
          </a>
        )}
      </div>
    ))}
  </div>

  {Content ? <Content /> : <div class="empty-state">Выберите заметку в меню слева</div>}
</WikiLayout>

<style>
  /* Сокращаем отступы в Sidebar */
  .wiki-tree { display: flex; flex-direction: column; gap: 2px; }
  
  summary {
    list-style: none;
    padding: 4px 8px; /* Уменьшили */
    cursor: pointer;
    color: #999;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 6px;
    border-radius: 4px;
  }
  summary:hover { background: #1a1a1a; color: #fff; }

  .folder-content {
    margin-left: 12px; /* Уменьшили отступ */
    border-left: 1px solid #222;
    display: flex;
    flex-direction: column;
  }

  .file-link {
    display: block;
    padding: 4px 12px; /* Уменьшили */
    color: #777;
    text-decoration: none;
    font-size: 0.85rem;
    border-radius: 4px;
  }
  .file-link:hover { background: #1a1a1a; color: #fff; }
  .file-link.active { color: #3498db; background: rgba(52, 152, 219, 0.1); }

  .empty-state {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: #444;
    font-size: 1.2rem;
  }
</style>
