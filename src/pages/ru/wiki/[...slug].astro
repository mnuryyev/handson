---
import { getCollection, render } from 'astro:content';
import WikiLayout from '../../../layouts/WikiLayout.astro';

// 1. Используем id вместо slug для Astro 5 glob loader
export async function getStaticPaths() {
  const wikiEntries = await getCollection('wiki');
  return wikiEntries.map(entry => ({
    // Убираем расширение .md из id для красивого URL
    params: { slug: entry.id.replace(/\.md$/, '') }, 
    props: { entry },
  }));
}

const { entry } = Astro.props;
// В Astro 5 используется render(entry)
const { Content, headings } = await render(entry);

// 2. Получаем все файлы для сайдбара
const allEntries = await getCollection('wiki');
---

<WikiLayout title={entry.data.title} headings={headings}>
<div slot="sidebar" class="file-tree">
    {allEntries.map(item => {
      const cleanSlug = item.id.replace(/\.md$/, '');
      const parts = cleanSlug.split('/');
      const isNested = parts.length > 1;
      
      return (
        <a href={`/handson/ru/wiki/${cleanSlug}`} 
           class="file-link" 
           style={`padding-left: ${isNested ? parts.length * 12 : 12}px`}>
          {isNested ? '└ ' : '📁 '} {item.data.title || parts.at(-1)}
        </a>
      )
    })}
  </div>

  <Content />
</WikiLayout>

<style>
  .file-tree { display: flex; flex-direction: column; gap: 5px; }
  .file-link {
    color: #aaa;
    text-decoration: none;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.9rem;
    transition: 0.2s;
  }
  .file-link:hover { background: #1a1a1a; color: #fff; }
</style>
