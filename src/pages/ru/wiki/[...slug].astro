---
import { getCollection, render } from 'astro:content';
import WikiLayout from '../../../layouts/WikiLayout.astro';
import WikiTree from '../../../components/WikiTree.astro';

export async function getStaticPaths() {
  const wikiEntries = await getCollection('wiki');
  // Фильтруем только те файлы, которые лежат в папке ru/
  const ruEntries = wikiEntries.filter(entry => entry.id.startsWith('ru/'));
  
  return ruEntries.map(entry => ({
    // Для параметров slug убираем префикс ru/ и расширение .md
    params: { slug: entry.id.replace(/^ru\//, '').replace(/\.md$/, '') }, 
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allEntries = await getCollection('wiki');

// 1. Оставляем только РУССКИЕ записи для сайдбара
const ruEntries = allEntries.filter(item => item.id.startsWith('ru/'));
const currentSlug = Astro.params.slug || '';

function buildTree(entries) {
  const tree = {};
  entries.forEach(item => {
    // 2. ВАЖНО: Отрезаем 'ru/' в начале ID, чтобы дерево не создавало лишнюю папку "ru"
    const cleanId = item.id.replace(/^ru\//, '').replace(/\.md$/, '');
    const parts = cleanId.split('/');
    let current = tree;

    parts.forEach((part, index) => {
      if (!current[part]) {
        if (index === parts.length - 1) {
          current[part] = { type: 'file', title: item.data?.title || part, slug: cleanId };
        } else {
          current[part] = { type: 'folder', children: {} };
        }
      }
      if (current[part].type === 'folder') {
        current = current[part].children;
      }
    });
  });
  return tree;
}

const fileTree = buildTree(ruEntries);
---

<WikiLayout title={entry.data.title}>
  <WikiTree slot="sidebar" tree={fileTree} currentSlug={currentSlug} lang="ru" />
  <Content />
</WikiLayout>

<style>
  .wiki-tree { display: flex; flex-direction: column; gap: 2px; }
  summary {
    list-style: none;
    padding: 6px 10px;
    cursor: pointer;
    color: #888;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 8px;
    border-radius: 4px;
  }
  summary:hover { background: #1a1a1a; color: #eee; }
  summary::-webkit-details-marker { display: none; }

  .folder-content {
    margin-left: 14px;
    border-left: 1px solid #222;
    padding-left: 4px;
    display: flex;
    flex-direction: column;
  }

  .file-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    color: #666;
    text-decoration: none;
    font-size: 0.85rem;
    border-radius: 4px;
  }
  .file-link:hover { background: #1a1a1a; color: #fff; }
  .file-link.active {
    background: rgba(52, 152, 219, 0.1);
    color: #3498db;
    font-weight: 500;
  }
</style>
