---
import MainLayout from '../../../layouts/MainLayout.astro';
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';
import { marked } from 'marked';

const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base : `${base}/`;

export async function getStaticPaths() {
  const articlesDir = './src/content/articles/ru';
  if (!fs.existsSync(articlesDir)) return [];
  
  const files = fs.readdirSync(articlesDir).filter(f => f.endsWith('.md'));
  return files.map(file => ({ params: { slug: file.replace('.md', '') } }));
}

const { slug } = Astro.params;
const lang = "ru";
const filePath = path.join('./src/content/articles/ru', `${slug}.md`);
const fileContent = fs.readFileSync(filePath, 'utf-8');

// Извлекаем данные статьи
const { data, content } = matter(fileContent);
const htmlContent = marked.parse(content);
---

<MainLayout title={data.title}>
  <div class="article-container">
    <nav class="breadcrumb">
      <a href={`${cleanBase}${lang}/articles/1`}>Сети</a>
      <span class="sep">/</span>
      <span class="current">{data.title}</span>
    </nav>

    <article class="prose">
      <header class="article-header">
        <h1>{data.title}</h1>
        {data.date && (
          <time class="article-date">{new Date(data.date).toISOString().split('T')[0]}</time>
        )}
      </header>

      <div class="article-body markdown-content" set:html={htmlContent} />

      {data.tags && data.tags.length > 0 && (
        <div class="post-footer-tags">
          <span class="tags-label">Теги</span>
          <div class="tags-list">
            {data.tags.map((tag) => (
              <a href={`${cleanBase}${lang}/tags/${tag.toLowerCase()}`} class="tag-item">
                #{tag.toLowerCase()}
              </a>
            ))}
          </div>
        </div>
      )}
    </article>
  </div>
</MainLayout>

<style>
  .article-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 48px 24px 80px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 32px;
    font-size: 0.85rem;
  }

  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.2s;
  }

  .breadcrumb a:hover { opacity: 1; }

  .breadcrumb .sep {
    color: var(--text-3);
    font-size: 0.75rem;
  }

  .breadcrumb .current {
    color: var(--text-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 320px;
  }

  .article-header {
    margin-bottom: 36px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }

  .article-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.2;
    letter-spacing: -0.5px;
    margin: 0 0 12px;
  }

  .article-date {
    display: inline-block;
    font-size: 0.78rem;
    color: var(--text-3);
    font-family: 'JetBrains Mono', monospace;
  }

  .post-footer-tags {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }

  .tags-label {
    display: block;
    font-size: 0.68rem;
    color: var(--text-3);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 1.5px;
    margin-bottom: 12px;
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 768px) {
    .article-container { padding: 28px 16px 60px; }
    .breadcrumb .current { max-width: 180px; }
  }
</style>
