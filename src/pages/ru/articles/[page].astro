---
import MainLayout from '../../../layouts/MainLayout.astro';
import LabCard from '../../../components/LabCard.astro'; 
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';

export async function getStaticPaths({ paginate }) {
  // Читаем из подпапки ru
  const articlesDir = './src/content/articles/ru';
  
  const files = fs.existsSync(articlesDir) 
    ? fs.readdirSync(articlesDir).filter(f => f.endsWith('.md'))
    : [];

  const allArticles = files.map(file => {
    const fileContent = fs.readFileSync(path.join(articlesDir, file), 'utf-8');
    const { data } = matter(fileContent);
    return {
      slug: file.replace('.md', ''),
      ...data
    };
  }).sort((a, b) => new Date(b.date || 0).getTime() - new Date(a.date || 0).getTime());

  return paginate(allArticles, { pageSize: 12 });
}

const { page } = Astro.props;
const lang = "ru"; 
---

<MainLayout title={`Сети — Страница ${page.currentPage}`}>
  <div class="list-container">
    <header class="page-header">
      <div class="header-label">Раздел</div>
      <h1>🌐 Сети и администрирование</h1>
      <p>Разборы и практические заметки по сетям и системному администрированию</p>
    </header>

    <div class="cards-list">
      {page.data.map(article => (
        <LabCard
          horizontal={true}
          title={article.title}
          desc={article.description}
          date={article.date}
          url={`/${lang}/articles/${article.slug}`}
          image={article.image}
        />
      ))}
    </div>

    <nav class="pagination">
      {page.url.prev ? (
        <a href={page.url.prev} class="p-btn">← Назад</a>
      ) : (
        <span class="p-btn disabled">← Назад</span>
      )}
      <span class="pages">{page.currentPage} / {page.lastPage}</span>
      {page.url.next ? (
        <a href={page.url.next} class="p-btn">Вперед →</a>
      ) : (
        <span class="p-btn disabled">Вперед →</span>
      )}
    </nav>
  </div>
</MainLayout>

<style>
  .list-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 52px 24px 80px;
  }

  .page-header {
    margin-bottom: 44px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }

  .header-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .page-header h1 {
    font-size: 1.9rem;
    font-weight: 800;
    margin: 0 0 10px;
    color: #fff;
    letter-spacing: -0.5px;
  }

  .page-header p {
    color: var(--text-2);
    margin: 0;
    font-size: 0.95rem;
  }

  .cards-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pagination {
    margin-top: 56px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
  }

  .p-btn {
    padding: 8px 18px;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-2);
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s;
  }

  .p-btn:hover {
    border-color: rgba(62, 166, 255, 0.35);
    color: var(--accent);
    background: rgba(62, 166, 255, 0.05);
  }

  .p-btn.disabled {
    opacity: 0.25;
    pointer-events: none;
  }

  .pages {
    color: var(--text-3);
    font-size: 0.875rem;
    font-family: monospace;
  }

  @media (max-width: 768px) {
    .list-container { padding: 28px 16px 60px; }
    .page-header { margin-bottom: 24px; padding-bottom: 20px; }
    .page-header h1 { font-size: 1.45rem; }
    .cards-list { gap: 10px; }
    .pagination { margin-top: 36px; gap: 10px; }
  }
</style>
