---
import MainLayout from '../../../layouts/MainLayout.astro';
import LabCard from '../../../components/LabCard.astro'; 
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';

export async function getStaticPaths({ paginate }) {
  // Читаем из подпапки ru
  const articlesDir = './src/content/articles/ru';
  
  const files = fs.existsSync(articlesDir) 
    ? fs.readdirSync(articlesDir).filter(f => f.endsWith('.md'))
    : [];

  const allArticles = files.map(file => {
    const fileContent = fs.readFileSync(path.join(articlesDir, file), 'utf-8');
    const { data } = matter(fileContent);
    return {
      slug: file.replace('.md', ''),
      ...data
    };
  }).sort((a, b) => new Date(b.date || 0).getTime() - new Date(a.date || 0).getTime());

  return paginate(allArticles, { pageSize: 12 });
}

const { page } = Astro.props;
const lang = "ru"; 
---

<MainLayout title={`Статьи - Страница ${page.currentPage}`}>
  <div class="container">
    <header class="page-header">
      <h1>🌐 Сети и администрирование</h1>
      <p>Разборы и практические заметки по сетям и администрированию</p>
    </header>

    <div class="grid">
      {page.data.map(article => (
        <LabCard 
          title={article.title} 
          desc={article.description} 
          date={article.date} 
          url={`/${lang}/articles/${article.slug}`} 
          image={article.image}
        />
      ))}
    </div>

    <nav class="pagination">
      {page.url.prev ? (
        <a href={page.url.prev} class="p-btn">← Назад</a>
      ) : (
        <span class="p-btn disabled">← Назад</span>
      )}
      <div class="pages">{page.currentPage} / {page.lastPage}</div>
      {page.url.next ? (
        <a href={page.url.next} class="p-btn">Вперед →</a>
      ) : (
        <span class="p-btn disabled">Вперед →</span>
      )}
    </nav>
  </div>
</MainLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 60px auto;
    padding: 0 20px;
  }

  .page-header {
    margin-bottom: 50px;
    border-bottom: 1px solid #222;
    padding-bottom: 30px;
  }

  .page-header h1 {
    font-size: 2rem;
    margin: 0 0 10px 0;
    color: #fff;
  }

  .page-header p {
    color: #888;
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 40px 25px;
  }

  .pagination {
    margin-top: 60px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
  }

  .p-btn {
    padding: 8px 16px;
    background: #111;
    border: 1px solid #333;
    border-radius: 6px;
    text-decoration: none;
    color: #fff;
    transition: 0.2s;
  }

  .p-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .p-btn.disabled {
    opacity: 0.3;
    pointer-events: none;
  }

  .pages {
    color: #666;
    font-size: 0.9rem;
  }

  /* Мобильные — только для этой страницы */
  @media (max-width: 768px) {
    .container {
      margin: 24px auto;
      padding: 0 16px;
    }

    .page-header {
      margin-bottom: 24px;
      padding-bottom: 20px;
    }

    .page-header h1 {
      font-size: 1.4rem;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .pagination {
      margin-top: 36px;
      gap: 10px;
    }

    .p-btn {
      padding: 8px 12px;
      font-size: 0.85rem;
    }
  }
</style>
