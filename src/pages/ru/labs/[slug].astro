---
import MainLayout from '../../../layouts/MainLayout.astro'; // Исправили путь (3 уровня вверх)
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';
import { marked } from 'marked';
const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base : `${base}/`;

export async function getStaticPaths() {
  // Теперь ищем файлы в папке контента для русского языка
  const labsDir = './src/content/labs/ru';
  
  if (!fs.existsSync(labsDir)) return [];

  const files = fs.readdirSync(labsDir).filter(f => f.endsWith('.md'));

  return files.map(file => ({
    params: { slug: file.replace('.md', '') }
  }));
}

const { slug } = Astro.params;
const lang = "ru"; // Указываем язык текущей страницы

// Путь к конкретному файлу тоже теперь включает /ru/
const filePath = path.join('./src/content/labs/ru', `${slug}.md`);
const fileContent = fs.readFileSync(filePath, 'utf-8');
const { data, content } = matter(fileContent);

// Превращаем Markdown в HTML
const htmlContent = marked.parse(content);
---

<MainLayout title={data.title}>
  <div class="article-container">
    <nav class="breadcrumb">
      <a href={`${cleanBase}${lang}/labs/1`}>Безопасность</a>
      <span class="sep">/</span>
      <span class="current">{data.title}</span>
    </nav>

    <article class="prose">
      <header class="article-header">
        <h1>{data.title}</h1>
        {data.date && (
          <time class="article-date">{new Date(data.date).toISOString().split('T')[0]}</time>
        )}
      </header>

      <div class="article-body markdown-content" set:html={htmlContent} />
    </article>
  </div>
</MainLayout>

<style>
  .article-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 48px 24px 80px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 32px;
    font-size: 0.85rem;
  }

  .breadcrumb a { color: var(--accent); opacity: 0.8; transition: opacity 0.2s; }
  .breadcrumb a:hover { opacity: 1; }
  .breadcrumb .sep { color: var(--text-3); font-size: 0.75rem; }
  .breadcrumb .current { color: var(--text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 320px; }

  .article-header {
    margin-bottom: 36px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }

  .article-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.2;
    letter-spacing: -0.5px;
    margin: 0 0 12px;
  }

  .article-date {
    display: inline-block;
    font-size: 0.78rem;
    color: var(--text-3);
    font-family: 'JetBrains Mono', monospace;
  }

  @media (max-width: 768px) {
    .article-container { padding: 28px 16px 60px; }
    .breadcrumb .current { max-width: 180px; }
  }
</style>
