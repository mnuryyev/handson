---
import MainLayout from '../../../layouts/MainLayout.astro'; // Исправили путь (3 уровня вверх)
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';
import { marked } from 'marked';
const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base : `${base}/`;

export async function getStaticPaths() {
  // Теперь ищем файлы в папке контента для русского языка
  const labsDir = './src/content/labs/ru';
  
  if (!fs.existsSync(labsDir)) return [];

  const files = fs.readdirSync(labsDir).filter(f => f.endsWith('.md'));

  return files.map(file => ({
    params: { slug: file.replace('.md', '') }
  }));
}

const { slug } = Astro.params;
const lang = "ru"; // Указываем язык текущей страницы

// Путь к конкретному файлу тоже теперь включает /ru/
const filePath = path.join('./src/content/labs/ru', `${slug}.md`);
const fileContent = fs.readFileSync(filePath, 'utf-8');
const { data, content } = matter(fileContent);

// Превращаем Markdown в HTML
const htmlContent = marked.parse(content);
---

<MainLayout title={data.title}>
  <div class="article-container">
    <nav class="breadcrumb">
      <a href={`${cleanBase}${lang}/labs/1`}>Безопасность</a> 
      <span class="sep">/</span> 
      <span class="current">{data.title}</span>
    </nav>

    <article class="prose">
      <header class="article-header">
        <h1>{data.title}</h1>
      </header>
      
      <div class="article-body markdown-content" set:html={htmlContent} />
    </article>
  </div>
</MainLayout>

<style>
  .article-container {
    max-width: 1000px; /* Уменьшил ширину контейнера для удобства чтения */
    margin: 40px auto;
    padding: 0 24px;
  }

  .breadcrumb { margin-bottom: 25px; font-size: 0.9rem; color: #666; }
  .breadcrumb a { color: var(--accent); text-decoration: none; }
  .breadcrumb .sep { margin: 0 10px; opacity: 0.3; }

  /* Настройка главного заголовка (Title) */
  .article-header h1 { 
    font-size: 1.8rem; /* Сделал поменьше, как ты просил */
    margin-bottom: 20px; 
    letter-spacing: -0.5px; 
    color: #fff; 
    line-height: 1.2;
  }
  
  /* УДАЛИЛИ старые стили для .article-body, h2, pre, img, 
     потому что они теперь подтягиваются из .markdown-content в global.css */

  @media (max-width: 768px) {
    .article-container { margin: 20px auto; padding: 0 16px; }
    .article-header h1 { font-size: 1.5rem; }
  }
</style>
