---
import MainLayout from '../../../layouts/MainLayout.astro'; // Исправили путь (3 уровня вверх)
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';
import { marked } from 'marked';
const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base : `${base}/`;

export async function getStaticPaths() {
  // Теперь ищем файлы в папке контента для русского языка
  const labsDir = './src/content/labs/ru';
  
  if (!fs.existsSync(labsDir)) return [];

  const files = fs.readdirSync(labsDir).filter(f => f.endsWith('.md'));

  return files.map(file => ({
    params: { slug: file.replace('.md', '') }
  }));
}

const { slug } = Astro.params;
const lang = "ru"; // Указываем язык текущей страницы

// Путь к конкретному файлу тоже теперь включает /ru/
const filePath = path.join('./src/content/labs/ru', `${slug}.md`);
const fileContent = fs.readFileSync(filePath, 'utf-8');
const { data, content } = matter(fileContent);

// Превращаем Markdown в HTML
const htmlContent = marked.parse(content);
---

<MainLayout title={data.title}>
  <div class="article-outer">
    <div class="article-container">

      <nav class="breadcrumb">
        <a href={`${cleanBase}${lang}/labs/1`}>
          <svg width="12" height="12" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
          </svg>
          Безопасность
        </a>
        <span class="sep">/</span>
        <span class="current">{data.title}</span>
      </nav>

      <article>
        <header class="article-header">
          <h1>{data.title}</h1>
          {data.description && <p class="article-desc">{data.description}</p>}
          <div class="article-meta">
            {data.date && (
              <span class="meta-item">
                <svg width="13" height="13" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                </svg>
                <time>{new Date(data.date).toISOString().split('T')[0]}</time>
              </span>
            )}
            {data.tags && data.tags.length > 0 && (
              <div class="meta-tags">
                {data.tags.slice(0, 3).map(tag => (
                  <span class="tag-pill">{tag}</span>
                ))}
              </div>
            )}
          </div>
        </header>

        <div class="article-body markdown-content" set:html={htmlContent} />

        <footer class="article-footer">
          <a href={`${cleanBase}${lang}/labs/1`} class="back-link">
            <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
            </svg>
            Назад к разделу
          </a>
          {data.tags && data.tags.length > 0 && (
            <div class="footer-tags">
              {data.tags.map(tag => (
                <a href={`${cleanBase}${lang}/tags/${tag.toLowerCase()}`} class="tag-item">#{tag.toLowerCase()}</a>
              ))}
            </div>
          )}
        </footer>
      </article>
    </div>
  </div>
</MainLayout>

<style>
  .article-outer { padding: 40px 0 80px; }

  .article-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 36px;
    font-size: 0.82rem;
  }

  .breadcrumb a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--accent);
    opacity: 0.75;
    font-weight: 500;
    transition: opacity 0.2s;
  }

  .breadcrumb a:hover { opacity: 1; }
  .breadcrumb .sep { color: var(--text-3); }
  .breadcrumb .current { color: var(--text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 340px; }

  .article-header {
    margin-bottom: 40px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }

  .article-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.18;
    letter-spacing: -0.5px;
    margin: 0 0 14px;
  }

  .article-desc {
    font-size: 1rem;
    color: var(--text-2);
    line-height: 1.65;
    margin: 0 0 18px;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.78rem;
    color: var(--text-3);
    font-family: 'JetBrains Mono', monospace;
  }

  .meta-tags { display: flex; gap: 6px; flex-wrap: wrap; }

  .tag-pill {
    background: rgba(62, 166, 255, 0.08);
    color: var(--accent);
    border: 1px solid rgba(62, 166, 255, 0.18);
    padding: 2px 10px;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .article-body {
    font-size: 1.05rem;
    line-height: 1.82;
    color: #ccd4e0;
  }

  .article-footer {
    margin-top: 60px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-2);
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  .back-link:hover { color: var(--accent); }
  .footer-tags { display: flex; flex-wrap: wrap; gap: 8px; }

  @media (max-width: 768px) {
    .article-outer { padding: 24px 0 60px; }
    .article-container { padding: 0 16px; }
    .breadcrumb .current { max-width: 180px; }
    .article-footer { flex-direction: column; align-items: flex-start; }
  }
</style>
