---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base : `${base}/`;

export async function getStaticPaths() {
  const languages = ['ru', 'en'];
  const allLabs = await getCollection('labs');
  const allArticles = await getCollection('articles');
  const allWiki = await getCollection('wiki');
  
  const allContent = [...allLabs, ...allArticles, ...allWiki];

  return languages.flatMap((lang) => {
    const langContent = allContent.filter(item => item.id.startsWith(`${lang}/`));
    
    // ПУНКТ 1: Приводим все теги к нижнему регистру при сборе
    const uniqueTags = [...new Set(
      langContent.map((item) => item.data.tags || [])
        .flat()
        .map(tag => tag.toLowerCase()) // ← ВСЕ МАЛЕНЬКИЕ
    )];

    return uniqueTags.map((tag) => ({
      params: { lang, tag },
      props: { 
        // При фильтрации тоже сравниваем в нижнем регистре
        posts: langContent.filter((item) => 
          item.data.tags?.map(t => t.toLowerCase()).includes(tag)
        ),
      },
    }));
  });
}

const { lang, tag } = Astro.params;
const { posts } = Astro.props;

// Словарь для перевода названий разделов (ПУНКТ 2)
const sectionNames = {
  ru: {
    articles: 'Сети',
    labs: 'Безопасность',
    wiki: 'Вики',
  },
  en: {
    articles: 'Networks',
    labs: 'Security',
    wiki: 'Wiki',
  }
};

const titleText = lang === 'en' ? `Tag: ${tag}` : `Тег: ${tag}`;
---

<MainLayout title={titleText}>
  <div class="container">
    <div class="tag-header">
      <span class="tag-label">{lang === 'en' ? 'Browsing Tag' : 'Просмотр тега'}</span>
      <h1 class="tag-title">#{tag.toLowerCase()}</h1> </div>
    
    <div class="results-grid">
      {posts.map((post) => {
        const collection = post.collection;
        const slug = post.id.split('/').pop().replace('.md', '');
        const finalHref = `${cleanBase}${lang}/${collection}/${slug}`;
        
        // ПУНКТ 2: Берем название из словаря выше
        const displayName = sectionNames[lang][collection] || collection;

        return (
          <a href={finalHref} class="result-card">
            <div class="card-content">
               <div class="meta-top">
                 <span class="category">{displayName}</span> {post.data.date && <span class="date">{post.data.date}</span>}
               </div>
               <h3>{post.data.title}</h3>
               <p>{post.data.description || ""}</p>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</MainLayout>

<style>
  /* Стили оставляем те же, что были в предыдущем шаге */
  .container { max-width: 1000px; margin: 60px auto; padding: 0 20px; }
  .tag-header { margin-bottom: 50px; border-bottom: 1px solid #1a1a1a; padding-bottom: 20px; }
  .tag-label { color: #555; font-size: 0.8rem; text-transform: uppercase; font-weight: bold; }
  .tag-title { color: #3ea6ff; font-size: 3rem; margin-top: 10px; }
  .results-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 25px; }
  .result-card { background: #0a0a0a; border: 1px solid #1e293b; border-radius: 12px; padding: 24px; text-decoration: none !important; transition: 0.3s; }
  .result-card:hover { border-color: #3ea6ff; transform: translateY(-5px); }
  .meta-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
  .category { font-size: 0.7rem; text-transform: uppercase; color: #3ea6ff; background: rgba(62, 166, 255, 0.1); padding: 2px 8px; border-radius: 4px; font-weight: bold; }
  .date { font-size: 0.75rem; color: #444; }
  .result-card h3 { color: #fff; margin: 0 0 10px 0; font-size: 1.4rem; }
  .result-card p { color: #888; font-size: 0.95rem; line-height: 1.5; }
</style>
