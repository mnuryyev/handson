---
import MainLayout from './MainLayout.astro';
import WikiSearch from '../components/WikiSearch.astro';

const { title, lang = "ru", searchData = [], date } = Astro.props; 

// Форматируем дату в строгий ISO формат YYYY-MM-DD
const formattedDate = date ? new Date(date).toISOString().split('T')[0] : null;

// Локализация текста заголовка даты
const dateLabel = lang === 'en' ? 'Updated' : 'Обновлено';
---

<MainLayout title={title}>
  <div class="wiki-container">
    <div class="mobile-wiki-header">
      <button id="wiki-mobile-toggle" class="mobile-toggle-btn">
        <span>☰</span> {lang === 'en' ? 'Wiki Menu' : 'Разделы Wiki'}
      </button>
    </div>

    <aside class="wiki-sidebar" id="wiki-sidebar">
      <div class="sidebar-header">Wiki Navigation</div>
      
      <div class="search-section">
        {searchData && searchData.length > 0 && (
          <WikiSearch lang={lang} searchData={searchData} />
        )}
      </div>
      
      <div class="tree-section">
        <slot name="sidebar" />
      </div>
    </aside>

    <article class="wiki-main">
      <div class="wiki-content-wrapper">
        <header class="content-header">
          <h1>{title}</h1>
          {formattedDate && (
            <time class="post-date">
              {dateLabel}: {formattedDate}
            </time>
          )}
        </header>
        
        <hr class="header-divider" />

        <section class="markdown-body">
          <slot />
        </section>
      </div>
    </article>

    <div id="sidebar-overlay" class="sidebar-overlay"></div>
  </div>
</MainLayout>

<script is:inline>
  function handleExternalLinks() {
    const markdownContainer = document.querySelector('.markdown-body');
    if (!markdownContainer) return;
    const links = markdownContainer.querySelectorAll('a');
    links.forEach(link => {
      if (link.hostname && link.hostname !== window.location.hostname) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    });
  }

  function initMobileMenu() {
    const btn = document.getElementById('wiki-mobile-toggle');
    const sidebar = document.getElementById('wiki-sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    if (!btn || !sidebar) return;

    const toggle = () => {
      sidebar.classList.toggle('active');
      overlay?.classList.toggle('active');
    };

    btn.addEventListener('click', toggle);
    overlay?.addEventListener('click', toggle);
    sidebar.addEventListener('click', (e) => {
      if (e.target.closest('a')) {
        sidebar.classList.remove('active');
        overlay?.classList.remove('active');
      }
    });
  }

  handleExternalLinks();
  initMobileMenu();
  document.addEventListener('astro:after-swap', () => {
    handleExternalLinks();
    initMobileMenu();
  });
</script>

<style is:global>
  /* --- ТЕМНЫЙ СКРОЛЛБАР --- */
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-track { background: #0d0d0d; }
  ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 4px; border: 2px solid #0d0d0d; }
  ::-webkit-scrollbar-thumb:hover { background: #3498db; }
  * { scrollbar-width: thin; scrollbar-color: #1e293b #0d0d0d; }

  /* --- WIKI BLUE MARKDOWN STYLES --- */
  .markdown-body {
    font-size: 17px;
    line-height: 1.7;
    color: #cbd5e1;
  }

  .markdown-body h1, 
  .markdown-body h2, 
  .markdown-body h3 {
    font-weight: 800;
    color: #fff;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .markdown-body h1 { font-size: 1.8rem; border-bottom: 2px solid #1a2638; padding-bottom: 0.3em; }
  .markdown-body h2 { font-size: 1.4rem; border-bottom: 2px solid #1a2638; padding-bottom: 0.3em; }
  .markdown-body h3 { font-size: 1.2rem; }

  .markdown-body blockquote {
    margin: 16px 0;
    padding: 8px 16px;
    color: #94a3b8;
    border-left: 4px solid #3498db;
    background: rgba(52, 152, 219, 0.08);
    font-style: italic;
    border-radius: 0 8px 8px 0;
  }

  .markdown-body table {
    display: block;            
    width: fit-content;        
    max-width: 100%;           
    overflow-x: auto;          
    border-collapse: collapse;
    margin: 24px 0;            
    border: 1px solid #1e293b; 
    background: #0a0a0a;
    border-radius: 8px;
  }
  
  .markdown-body th { 
    background: #111827;       
    color: #3498db;            
    padding: 12px 16px;        
    border-bottom: 2px solid #1e293b; 
    text-align: left;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 13px;
    letter-spacing: 0.5px;
  }
  
  .markdown-body td { 
    padding: 10px 16px; 
    border-bottom: 1px solid #111827; 
    color: #cbd5e1;
    font-size: 14px;
    white-space: nowrap;
  }

  .markdown-body td:nth-child(3) {
    white-space: normal;      
    min-width: 250px;         
    max-width: 450px;         
  }

  .markdown-body tr:hover { background: #0f172a; }

  .markdown-body :not(pre) > code {
    background: #111827;
    color: #60a5fa; 
    padding: 0.2em 0.4em;
    border-radius: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    border: 1px solid #1e293b;
    vertical-align: middle;
  }

  .markdown-body pre {
    background: #0b0b0b;
    padding: 20px;
    border-radius: 12px;
    border: 1px solid #222;
    margin: 1.5em 0;
    overflow-x: auto;
  }

  .markdown-body pre code {
    font-size: 13px;
    background: transparent;
    padding: 0;
    border: none;
  }

  .markdown-body ul, .markdown-body ol { padding-left: 2em; margin-bottom: 16px; }
  .markdown-body li { margin-bottom: 8px; }
  .markdown-body a { color: #3498db; text-decoration: none; }
  .markdown-body a:hover { text-decoration: underline; }
</style>

<style>
  .wiki-container {
    display: grid;
    grid-template-columns: 260px 1fr;
    min-height: calc(100vh - 64px);
    background: #0d0d0d;
    position: relative;
    align-items: start;
    /* Ограничиваем общую ширину на огромных экранах */
    max-width: 1300px; 
    margin: 0 auto;
  }

  /* Обертка контента для соблюдения ширины ~1000px внутри правой колонки */
  .wiki-content-wrapper {
    max-width: 1000px;
    margin: 0 auto;
    width: 100%;
  }

  .mobile-wiki-header {
    display: none;
    background: #050505;
    padding: 10px 16px;
    border-bottom: 1px solid #1a1a1a;
    grid-column: 1 / -1;
  }

  .wiki-sidebar {
    background: #050505;
    border-right: 1px solid #1a1a1a;
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    overflow-y: auto;
  }

  .sidebar-header {
    font-size: 0.7rem;
    color: #444;
    padding: 20px 20px 10px 20px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    flex-shrink: 0;
  }

  .search-section {
    padding: 10px 15px;
    margin-bottom: 10px;
    flex-shrink: 0;
  }

  .tree-section {
    flex-grow: 1;
    overflow-y: auto;
    padding: 10px 15px 30px 15px;
  }

  .wiki-main {
    padding: 40px 60px;
    background: #0d0d0d;
    min-height: 0;
    overflow-wrap: break-word;
    word-break: break-word;
    min-width: 0;
  }

  .post-date {
    display: block;
    font-size: 0.85rem;
    color: #555;
    margin-top: 12px;
    font-family: monospace;
  }

  .header-divider {
    border: 0;
    border-top: 1px solid #222;
    margin: 20px 0 30px 0;
  }

  .content-header h1 {
    font-size: 2.5rem;
    color: #fff;
    margin: 0;
  }

  .mobile-toggle-btn {
    background: #111;
    border: 1px solid #333;
    color: #fff;
    padding: 8px 15px;
    border-radius: 6px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: 0.2s;
  }

  .mobile-toggle-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sidebar-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    z-index: 1000;
    display: none;
  }

  @media (max-width: 1440px) {
    .wiki-container { max-width: 100%; }
  }

  @media (max-width: 768px) {
    .wiki-container {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .wiki-content-wrapper {
      max-width: 100%;
    }

    .mobile-wiki-header {
      display: flex;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 900;
    }

    .wiki-sidebar {
      position: fixed;
      top: 0;
      left: -300px;
      width: 280px;
      height: 100vh;
      z-index: 1050;
      transition: left 0.3s ease;
      box-shadow: 4px 0 20px rgba(0, 0, 0, 0.8);
    }

    .wiki-sidebar.active { left: 0; }
    .sidebar-overlay.active { display: block; }

    .wiki-main {
      padding: 20px 16px !important;
      width: 100%;
      max-width: 100vw;
    }

    .content-header h1 { font-size: 1.6rem; }
    body:has(.wiki-sidebar.active) { overflow: hidden; }
  }

  @media (max-width: 480px) {
    .content-header h1 { font-size: 1.3rem; }
  }
</style>
