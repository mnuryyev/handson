---
import MainLayout from './MainLayout.astro';
import WikiSearch from '../components/WikiSearch.astro';

const { title, lang = "ru", searchData = [] } = Astro.props; 
---

<MainLayout title={title}>
  <div class="wiki-container">
    <aside class="wiki-sidebar">
      <div class="sidebar-header">Wiki</div>
      
      <div class="search-section">
        {searchData.length > 0 && <WikiSearch lang={lang} searchData={searchData} />}
      </div>
      
      <div class="tree-section">
        <slot name="sidebar" />
      </div>
    </aside>

    <article class="wiki-main">
      <header class="content-header">
        <h1>{title}</h1>
      </header>
      <section class="markdown-body">
        <slot />
      </section>
    </article>
  </div>
</MainLayout>

<script is:inline>
  function handleExternalLinks() {
    const markdownContainer = document.querySelector('.markdown-body');
    if (!markdownContainer) return;

    const links = markdownContainer.querySelectorAll('a');
    links.forEach(link => {
      if (link.hostname && link.hostname !== window.location.hostname) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    });
  }

  handleExternalLinks();
  document.addEventListener('astro:after-swap', handleExternalLinks);
</script>

<style is:global>
  /* Фикс для модалки, чтобы она не перекрывала экран, когда закрыта */
  #search-modal {
    pointer-events: none; /* Игнорируем клики, когда закрыто */
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s, visibility 0.2s;
  }
  #search-modal.open {
    pointer-events: auto; /* Включаем клики, когда открыто */
    opacity: 1;
    visibility: visible;
  }

  /* СТИЛИЗАЦИЯ СКРОЛЛБАРА */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: #0d0d0d; }
  ::-webkit-scrollbar-thumb { background: #222; border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: #333; }

  .markdown-body {
    color: #ccc;
    line-height: 1.6;
    font-size: 1.05rem;
    max-width: 900px;
    margin: 0 auto;
  }
</style>

<style>
  .wiki-container {
    display: grid;
    grid-template-columns: 260px 1fr; 
    height: calc(100vh - 80px);
    background: #0d0d0d;
    overflow: hidden;
    position: relative;
  }

  .wiki-sidebar {
    background: #050505;
    border-right: 1px solid #1a1a1a;
    padding: 20px 10px;
    display: flex;
    flex-direction: column;
    overflow: hidden; /* Сайдбар сам не скроллится, скроллится дерево */
  }

  .search-section {
    flex-shrink: 0;
    margin-bottom: 10px;
  }

  .tree-section {
    flex-grow: 1;
    overflow-y: auto; /* Скроллим только список файлов */
    padding-right: 5px;
  }

  .wiki-main {
    padding: 40px 80px;
    overflow-y: auto;
    background: #0d0d0d;
    scroll-behavior: smooth;
  }

  .content-header h1 { font-size: 2.5rem; color: #fff; margin: 0; }
  .sidebar-header { font-size: 0.7rem; color: #444; margin-bottom: 15px; padding-left: 10px; text-transform: uppercase; letter-spacing: 1.5px; }

  @media (max-width: 768px) {
    .wiki-container { grid-template-columns: 1fr; }
    .wiki-sidebar { display: none; }
  }
</style>
