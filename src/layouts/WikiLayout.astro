---
import MainLayout from './MainLayout.astro';
import WikiSearch from '../components/WikiSearch.astro';

const { title, lang = "ru", searchData = [] } = Astro.props; 
---

<MainLayout title={title}>
  <div class="wiki-container">
    <button id="wiki-mobile-toggle" class="mobile-toggle-btn">
      <span class="icon">☰</span> Меню
    </button>

    <aside class="wiki-sidebar" id="wiki-sidebar">
      <div class="sidebar-header">Wiki</div>
      
      <div class="search-section">
        {searchData && searchData.length > 0 && (
          <WikiSearch lang={lang} searchData={searchData} />
        )}
      </div>
      
      <div class="tree-section">
        <slot name="sidebar" />
      </div>
    </aside>

    <article class="wiki-main">
      <header class="content-header">
        <h1>{title}</h1>
      </header>
      <section class="markdown-body">
        <slot />
      </section>
    </article>

    <div id="sidebar-overlay" class="sidebar-overlay"></div>
  </div>
</MainLayout>

<script is:inline>
  // Логика внешних ссылок
  function handleExternalLinks() {
    const markdownContainer = document.querySelector('.markdown-body');
    if (!markdownContainer) return;

    const links = markdownContainer.querySelectorAll('a');
    links.forEach(link => {
      if (link.hostname && link.hostname !== window.location.hostname) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    });
  }

  // Логика мобильного меню
  function initMobileMenu() {
    const btn = document.getElementById('wiki-mobile-toggle');
    const sidebar = document.getElementById('wiki-sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    if (!btn || !sidebar) return;

    const toggle = () => {
      sidebar.classList.toggle('active');
      overlay?.classList.toggle('active');
      btn.innerHTML = sidebar.classList.contains('active') ? '✕ Закрыть' : '☰ Меню';
    };

    btn.addEventListener('click', toggle);
    overlay?.addEventListener('click', toggle);

    // Закрывать при клике на ссылку
    sidebar.addEventListener('click', (e) => {
      if (e.target.closest('a')) {
        sidebar.classList.remove('active');
        overlay?.classList.remove('active');
        btn.innerHTML = '☰ Меню';
      }
    });
  }

  handleExternalLinks();
  initMobileMenu();
  
  document.addEventListener('astro:after-swap', () => {
    handleExternalLinks();
    initMobileMenu();
  });
</script>

<style is:global>
  /* Фикс для модалки поиска */
  #search-modal {
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s, visibility 0.2s;
    z-index: 2000;
  }
  #search-modal.open {
    pointer-events: auto;
    opacity: 1;
    visibility: visible;
  }

  /* Скроллбар */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: #0d0d0d; }
  ::-webkit-scrollbar-thumb { background: #222; border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: #333; }

  .markdown-body {
    color: #ccc;
    line-height: 1.6;
    font-size: 1.05rem;
    max-width: 900px;
    margin: 0 auto;
  }

  /* --- СИНИЕ ССЫЛКИ --- */
  .markdown-body a {
    color: #3498db; /* Насыщенный синий */
    text-decoration: none;
    transition: color 0.2s;
  }
  .markdown-body a:hover {
    color: #5dade2;
    text-decoration: underline;
  }

  /* --- АДАПТИВНЫЙ YOUTUBE --- */
  .markdown-body iframe {
    width: 100% !important;
    aspect-ratio: 16 / 9;
    height: auto !important;
    border-radius: 12px;
    margin: 20px 0;
    border: 1px solid #1a1a1a;
  }
</style>

<style>
  .wiki-container {
    display: grid;
    grid-template-columns: 260px 1fr; 
    height: calc(100vh - 80px);
    background: #0d0d0d;
    overflow: hidden;
    position: relative;
  }

  .wiki-sidebar {
    background: #050505;
    border-right: 1px solid #1a1a1a;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0 10px;
  }

  .sidebar-header { 
    font-size: 0.7rem; 
    color: #444; 
    padding: 20px 10px 10px 10px;
    text-transform: uppercase; 
    letter-spacing: 1.5px;
    flex-shrink: 0;
  }

  .search-section {
    flex-shrink: 0;
    padding: 0 5px;
    height: 50px;
    display: flex;
    align-items: center;
    margin-bottom: 10px;
  }

  .tree-section {
    flex-grow: 1;
    overflow-y: auto;
    padding: 0 5px 20px 5px;
  }

  .wiki-main {
    padding: 40px 80px;
    overflow-y: auto;
    background: #0d0d0d;
    scroll-behavior: smooth;
  }

  .content-header h1 { font-size: 2.5rem; color: #fff; margin: 0; }

  .mobile-toggle-btn {
    display: none;
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 1100;
    background: #1a1a1a;
    border: 1px solid #333;
    color: #fff;
    padding: 10px 18px;
    border-radius: 12px;
    font-size: 0.9rem;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(0,0,0,0.6);
  }

  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.7);
    z-index: 1000;
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .wiki-container { grid-template-columns: 1fr; }
    
    .mobile-toggle-btn { display: flex; align-items: center; gap: 8px; }

    .wiki-sidebar {
      position: fixed;
      top: 0;
      left: -280px;
      width: 280px;
      height: 100vh;
      z-index: 1050;
      transition: left 0.3s ease;
      box-shadow: 10px 0 30px rgba(0,0,0,0.5);
    }

    .wiki-sidebar.active {
      left: 0;
    }

    .sidebar-overlay.active {
      display: block;
      opacity: 1;
      pointer-events: auto;
    }

    .wiki-main {
      padding: 30px 20px;
    }
    
    .content-header h1 { font-size: 1.8rem; }
  }
</style>
