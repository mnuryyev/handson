---
import MainLayout from './MainLayout.astro';
import WikiSearch from '../components/WikiSearch.astro';

const { title, lang = "ru", searchData = [], date } = Astro.props; 

// Форматируем дату в строгий ISO формат YYYY-MM-DD
const formattedDate = date ? new Date(date).toISOString().split('T')[0] : null;

// Локализация текста заголовка даты
const dateLabel = lang === 'en' ? 'Updated' : 'Обновлено';
---

<MainLayout title={title}>
  <div class="wiki-container">
    <div class="mobile-wiki-header">
      <button id="wiki-mobile-toggle" class="mobile-toggle-btn">
        <span>☰</span> {lang === 'en' ? 'Wiki Menu' : 'Разделы Wiki'}
      </button>
    </div>

    <aside class="wiki-sidebar" id="wiki-sidebar">
      <div class="sidebar-header">Wiki Navigation</div>
      
      <div class="search-section">
        {searchData && searchData.length > 0 && (
          <WikiSearch lang={lang} searchData={searchData} />
        )}
      </div>
      
      <div class="tree-section">
        <slot name="sidebar" />
      </div>
    </aside>

    <article class="wiki-main">
      <header class="content-header">
        <h1>{title}</h1>
        {formattedDate && (
          <time class="post-date">
            {dateLabel}: {formattedDate}
          </time>
        )}
      </header>
      
      <hr class="header-divider" />

      <section class="markdown-body">
        <slot />
      </section>
    </article>

    <div id="sidebar-overlay" class="sidebar-overlay"></div>
  </div>
</MainLayout>

<script is:inline>
  function handleExternalLinks() {
    const markdownContainer = document.querySelector('.markdown-body');
    if (!markdownContainer) return;
    const links = markdownContainer.querySelectorAll('a');
    links.forEach(link => {
      if (link.hostname && link.hostname !== window.location.hostname) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    });
  }

  function initMobileMenu() {
    const btn = document.getElementById('wiki-mobile-toggle');
    const sidebar = document.getElementById('wiki-sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    if (!btn || !sidebar) return;

    const toggle = () => {
      sidebar.classList.toggle('active');
      overlay?.classList.toggle('active');
    };

    btn.addEventListener('click', toggle);
    overlay?.addEventListener('click', toggle);
    sidebar.addEventListener('click', (e) => {
      if (e.target.closest('a')) {
        sidebar.classList.remove('active');
        overlay?.classList.remove('active');
      }
    });
  }

  handleExternalLinks();
  initMobileMenu();
  document.addEventListener('astro:after-swap', () => {
    handleExternalLinks();
    initMobileMenu();
  });
</script>

<style is:global>
  /* Темный скроллбар */
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-track { background: #0d0d0d; }
  ::-webkit-scrollbar-thumb { background: #222; border-radius: 4px; border: 2px solid #0d0d0d; }
  ::-webkit-scrollbar-thumb:hover { background: #333; }
  * { scrollbar-width: thin; scrollbar-color: #222 #0d0d0d; }

  /* Markdown стили */
  .markdown-body blockquote {
    margin: 12px 0;
    padding: 8px 20px;
    color: #999;
    border-left: 4px solid #3498db;
    background: rgba(52, 152, 219, 0.05);
    font-style: italic;
    border-radius: 0 8px 8px 0;
  }

  .markdown-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 25px 0;
    border: 1px solid #222;
    overflow: hidden;
    border-radius: 8px;
  }
  .markdown-body th { background: #1a1a1a; padding: 12px; border-bottom: 2px solid #222; text-align: left; }
  .markdown-body td { padding: 12px; border-bottom: 1px solid #1a1a1a; color: #ccc; }

  .markdown-body a { color: #3498db; text-decoration: none; }
  .markdown-body a:hover { text-decoration: underline; }

  .markdown-body iframe { width: 100% !important; aspect-ratio: 16/9; border-radius: 12px; margin: 24px 0; }

  .markdown-body :not(pre) > code {
    background: #1a1a1a;
    color: #e68a00;
    padding: 2px 6px;
    border-radius: 4px;
    font-family: monospace;
    border: 1px solid #333;
  }
</style>

<style>
  .wiki-container {
    display: grid;
    grid-template-columns: 260px 1fr; 
    height: calc(100vh - 80px);
    background: #0d0d0d;
    position: relative;
  }

  .mobile-wiki-header {
    display: none;
    background: #050505;
    padding: 10px 20px;
    border-bottom: 1px solid #1a1a1a;
  }

  .wiki-sidebar {
    background: #050505;
    border-right: 1px solid #1a1a1a;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .sidebar-header { 
    font-size: 0.7rem; color: #444; padding: 20px 20px 10px 20px;
    text-transform: uppercase; letter-spacing: 1.5px;
  }

  .search-section {
    padding: 10px 15px;
    margin-bottom: 10px;
  }

  .tree-section {
    flex-grow: 1;
    overflow-y: auto;
    padding: 10px 15px 30px 15px;
  }

  .wiki-main {
    padding: 40px 60px;
    overflow-y: auto;
    background: #0d0d0d;
  }

  .post-date {
    display: block;
    font-size: 0.85rem;
    color: #555;
    margin-top: 12px;
    font-family: monospace; /* Для строгого вида даты */
  }

  .header-divider { border: 0; border-top: 1px solid #222; margin: 20px 0 30px 0; }

  .content-header h1 { font-size: 2.5rem; color: #fff; margin: 0; }

  .mobile-toggle-btn {
    background: #111;
    border: 1px solid #333;
    color: #fff;
    padding: 8px 15px;
    border-radius: 6px;
  }

  .sidebar-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,0.8);
    z-index: 1000; display: none;
  }

  @media (max-width: 768px) {
    .wiki-container { grid-template-columns: 1fr; height: auto; }
    .mobile-wiki-header { display: block; position: sticky; top: 0; z-index: 900; }
    .wiki-sidebar {
      position: fixed; top: 0; left: -280px;
      width: 280px; height: 100vh; z-index: 1050;
      transition: 0.3s ease;
    }
    .wiki-sidebar.active { left: 0; }
    .sidebar-overlay.active { display: block; opacity: 1; }
    .wiki-main { padding: 30px 20px; }
  }
</style>
