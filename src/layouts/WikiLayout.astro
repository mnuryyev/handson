---
import MainLayout from './MainLayout.astro';
import WikiSearch from '../components/WikiSearch.astro';

const { title, lang = "ru", searchData = [], date } = Astro.props; 

// Форматируем дату в строгий ISO формат YYYY-MM-DD
const formattedDate = date ? new Date(date).toISOString().split('T')[0] : null;

// Локализация текста заголовка даты
const dateLabel = lang === 'en' ? 'Updated' : 'Обновлено';
---

<MainLayout title={title}>
  <div class="wiki-container">
    <div class="mobile-wiki-header">
      <button id="wiki-mobile-toggle" class="mobile-toggle-btn">
        <span>☰</span> {lang === 'en' ? 'Wiki Menu' : 'Разделы Wiki'}
      </button>
    </div>

    <aside class="wiki-sidebar" id="wiki-sidebar">
      <div class="sidebar-header">Wiki Navigation</div>
      
      <div class="search-section">
        {searchData && searchData.length > 0 && (
          <WikiSearch lang={lang} searchData={searchData} />
        )}
      </div>
      
      <div class="tree-section">
        <slot name="sidebar" />
      </div>
    </aside>

    <article class="wiki-main">
      <header class="content-header">
        <h1>{title}</h1>
        {formattedDate && (
          <time class="post-date">
            {dateLabel}: {formattedDate}
          </time>
        )}
      </header>
      
      <hr class="header-divider" />

      <section class="markdown-body">
        <slot />
      </section>
    </article>

    <div id="sidebar-overlay" class="sidebar-overlay"></div>
  </div>
</MainLayout>

<script is:inline>
  function handleExternalLinks() {
    const markdownContainer = document.querySelector('.markdown-body');
    if (!markdownContainer) return;
    const links = markdownContainer.querySelectorAll('a');
    links.forEach(link => {
      if (link.hostname && link.hostname !== window.location.hostname) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    });
  }

  function initMobileMenu() {
    const btn = document.getElementById('wiki-mobile-toggle');
    const sidebar = document.getElementById('wiki-sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    if (!btn || !sidebar) return;

    const toggle = () => {
      sidebar.classList.toggle('active');
      overlay?.classList.toggle('active');
    };

    btn.addEventListener('click', toggle);
    overlay?.addEventListener('click', toggle);
    sidebar.addEventListener('click', (e) => {
      if (e.target.closest('a')) {
        sidebar.classList.remove('active');
        overlay?.classList.remove('active');
      }
    });
  }

  handleExternalLinks();
  initMobileMenu();
  document.addEventListener('astro:after-swap', () => {
    handleExternalLinks();
    initMobileMenu();
  });
</script>

<style is:global>
  /* Темный скроллбар */
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-track { background: #0d0d0d; }
  ::-webkit-scrollbar-thumb { background: #222; border-radius: 4px; border: 2px solid #0d0d0d; }
  ::-webkit-scrollbar-thumb:hover { background: #333; }
  * { scrollbar-width: thin; scrollbar-color: #222 #0d0d0d; }

<style is:global>
  /* Темный скроллбар */
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-track { background: #0d0d0d; }
  ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 4px; border: 2px solid #0d0d0d; }
  ::-webkit-scrollbar-thumb:hover { background: #3498db; }
  * { scrollbar-width: thin; scrollbar-color: #1e293b #0d0d0d; }

  /* --- Wiki Blue Markdown Styles --- */
  
  /* Заголовки: Жирные и сочные */
  .markdown-body h1, 
  .markdown-body h2, 
  .markdown-body h3 {
    font-weight: 800;
    color: #fff;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .markdown-body h1, 
  .markdown-body h2 {
    border-bottom: 2px solid #1a2638; /* Темно-синий разделитель */
    padding-bottom: 0.3em;
  }

  /* Цитаты */
  .markdown-body blockquote {
    margin: 12px 0;
    padding: 2px 12px;
    color: #94a3b8;
    border-left: 4px solid #3498db;
    background: rgba(52, 152, 219, 0.08);
    font-style: italic;
    border-radius: 0 12px 12px 0;
  }

  /* Таблицы: Строгий Wiki-вид */
  .markdown-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 25px 0;
    border: 1px solid #1e293b;
    overflow: hidden;
    border-radius: 8px;
    background: #0a0a0a;
  }
  
  .markdown-body th { 
    background: #111827; /* Полночно-синий */
    color: #3498db; 
    padding: 14px; 
    border-bottom: 2px solid #1e293b; 
    text-align: left;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .markdown-body td { 
    padding: 12px; 
    border-bottom: 1px solid #111827; 
    color: #cbd5e1; 
  }

  .markdown-body tr:hover {
    background: rgba(52, 152, 219, 0.03);
  }

  /* Ссылки */
  .markdown-body a { color: #3498db; text-decoration: none; font-weight: 500; }
  .markdown-body a:hover { color: #60a5fa; text-decoration: underline; }

  /* Инлайновый код: Маленький и аккуратный */
  .markdown-body :not(pre) > code {
    background: #111827;
    color: #60a5fa; /* Синий вместо оранжевого */
    padding: 0.2em 0.4em;
    border-radius: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85em; /* Уменьшили размер */
    border: 1px solid #1e293b;
    vertical-align: middle;
  }

  /* Списки */
  .markdown-body ul, .markdown-body ol { padding-left: 2em; margin-bottom: 16px; }
  .markdown-body li { margin-bottom: 6px; }
  .markdown-body li::marker { color: #3498db; font-weight: bold; }

  /* Видео и Медиа */
  .markdown-body iframe { width: 100% !important; aspect-ratio: 16/9; border-radius: 12px; margin: 24px 0; border: 1px solid #1e293b; }
</style>

<style>
  .wiki-container {
    display: grid;
    grid-template-columns: 260px 1fr;
    /* ИСПРАВЛЕНИЕ: min-height вместо height — контейнер растягивается по контенту */
    min-height: calc(100vh - 64px);
    background: #0d0d0d;
    position: relative;
    align-items: start; /* ИСПРАВЛЕНИЕ: колонки не растягиваются до высоты грида */
  }

  .mobile-wiki-header {
    display: none;
    background: #050505;
    padding: 10px 20px;
    border-bottom: 1px solid #1a1a1a;
  }

  .wiki-sidebar {
    background: #050505;
    border-right: 1px solid #1a1a1a;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* ИСПРАВЛЕНИЕ: сайдбар прилипает при скролле страницы */
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    overflow-y: auto;
  }

  .sidebar-header {
    font-size: 0.7rem;
    color: #444;
    padding: 20px 20px 10px 20px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }

  .search-section {
    padding: 10px 15px;
    margin-bottom: 10px;
  }

  .tree-section {
    flex-grow: 1;
    overflow-y: auto;
    padding: 10px 15px 30px 15px;
  }

  .wiki-main {
    padding: 40px 60px;
    /* ИСПРАВЛЕНИЕ: убираем overflow-y и height — скролл идёт по всей странице */
    background: #0d0d0d;
    min-height: 0;
  }

  .post-date {
    display: block;
    font-size: 0.85rem;
    color: #555;
    margin-top: 12px;
    font-family: monospace;
  }

  .header-divider {
    border: 0;
    border-top: 1px solid #222;
    margin: 20px 0 30px 0;
  }

  .content-header h1 {
    font-size: 2.5rem;
    color: #fff;
    margin: 0;
  }

  .mobile-toggle-btn {
    background: #111;
    border: 1px solid #333;
    color: #fff;
    padding: 8px 15px;
    border-radius: 6px;
  }

  .sidebar-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.8);
    z-index: 1000;
    display: none;
  }

  @media (max-width: 768px) {
    .wiki-container {
      grid-template-columns: 1fr;
      height: auto;
    }
    .mobile-wiki-header {
      display: block;
      position: sticky;
      top: 0;
      z-index: 900;
    }
    .wiki-sidebar {
      position: fixed;
      top: 0;
      left: -280px;
      width: 280px;
      height: 100vh;
      z-index: 1050;
      transition: 0.3s ease;
    }
    .wiki-sidebar.active { left: 0; }
    .sidebar-overlay.active { display: block; opacity: 1; }
    .wiki-main { padding: 30px 20px; }
  }
</style>
