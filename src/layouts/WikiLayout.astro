---
import MainLayout from './MainLayout.astro';
const { title, headings = [] } = Astro.props; // headings по умолчанию пустой массив
---
<MainLayout title={title}>
  <div class="wiki-container">
    <aside class="wiki-sidebar">
      <div class="sidebar-header">Wiki</div>
      <slot name="sidebar" />
    </aside>

    <article class="wiki-main">
      <header class="content-header">
        <h1>{title}</h1>
      </header>
      <section class="markdown-body">
        <slot />
      </section>
    </article>

    {headings && headings.length > 0 && (
      <aside class="wiki-toc">
        <div class="toc-title">На этой странице</div>
        <nav>
          {headings.map(h => (
            <a href={`#${h.slug}`} class={`toc-link depth-${h.depth}`}>{h.text}</a>
          ))}
        </nav>
      </aside>
    )}
  </div>
</MainLayout>

<style>
  .wiki-container {
    display: grid;
    /* Если есть оглавление - 3 колонки, если нет - 2 */
    grid-template-columns: 260px 1fr 240px; 
    height: calc(100vh - 80px);
    background: #0d0d0d;
  }

  /* Если TOC нет, растягиваем контент */
  .wiki-container:not(:has(.wiki-toc)) {
    grid-template-columns: 260px 1fr;
  }

  .wiki-sidebar {
    background: #050505;
    border-right: 1px solid #1a1a1a;
    padding: 20px 10px;
    overflow-y: auto;
  }

  .wiki-main {
    padding: 40px 60px;
    overflow-y: auto;
    background: #0d0d0d;
  }

  .wiki-toc {
    padding: 40px 20px;
    border-left: 1px solid #1a1a1a;
    background: #050505;
  }

  .sidebar-header { font-size: 0.75rem; color: #444; margin-bottom: 15px; padding-left: 10px; }
  .toc-title { color: #555; font-size: 0.8rem; margin-bottom: 15px; font-weight: bold; }
  .toc-link { display: block; color: #666; text-decoration: none; font-size: 0.85rem; margin-bottom: 8px; }
  .toc-link:hover { color: #3498db; }
  
  @media (max-width: 1100px) {
    .wiki-toc { display: none; }
    .wiki-container { grid-template-columns: 250px 1fr !important; }
  }
</style>
