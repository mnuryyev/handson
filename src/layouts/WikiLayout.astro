---
import MainLayout from './MainLayout.astro';
const { title, headings = [] } = Astro.props;
---
<MainLayout title={title}>
  <div class="wiki-container">
    <aside class="wiki-sidebar">
      <div class="sidebar-header">Wiki</div>
      <slot name="sidebar" />
    </aside>

    <article class="wiki-main">
      <header class="content-header">
        <h1>{title}</h1>
      </header>
      <section class="markdown-body">
        <slot />
      </section>
    </article>

    {headings && headings.length > 0 && (
      <aside class="wiki-toc">
        <div class="toc-title">На этой странице</div>
        <nav>
          {headings.map(h => (
            <a href={`#${h.slug}`} class={`toc-link depth-${h.depth}`}>{h.text}</a>
          ))}
        </nav>
      </aside>
    )}
  </div>
</MainLayout>

<script is:inline>
  function handleExternalLinks() {
    const markdownContainer = document.querySelector('.markdown-body');
    if (!markdownContainer) return;

    const links = markdownContainer.querySelectorAll('a');
    links.forEach(link => {
      // Проверяем, что ссылка ведет не на наш сайт
      if (link.hostname && link.hostname !== window.location.hostname) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    });
  }

  // Запуск при загрузке страницы
  handleExternalLinks();

  // Если используешь Astro View Transitions, раскомментируй строку ниже:
  // document.addEventListener('astro:after-swap', handleExternalLinks);
</script>

<style is:global>
  /* Глобальные стили для контента внутри Wiki (Markdown) */
  .markdown-body {
    color: #ccc;
    line-height: 1.6;
    font-size: 1rem;
  }

  .markdown-body h1, .markdown-body h2, .markdown-body h3 {
    color: #fff;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
    font-weight: 600;
  }

  /* Стили для изображений (как в Obsidian) */
  .markdown-body img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid #222;
    margin: 20px 0;
    display: block;
  }

  /* Адаптивный контейнер для YouTube */
  .video-container {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 */
    height: 0;
    overflow: hidden;
    max-width: 100%;
    background: #000;
    border-radius: 8px;
    margin: 24px 0;
  }

  .video-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Стили для ссылок в тексте */
  .markdown-body a {
    color: #3498db;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  .markdown-body a:hover {
    border-bottom-color: #3498db;
  }

  /* Цитаты */
  .markdown-body blockquote {
    margin: 20px 0;
    padding: 10px 20px;
    border-left: 4px solid #3498db;
    background: #161616;
    color: #aaa;
    border-radius: 0 4px 4px 0;
  }
</style>

<style>
  .wiki-container {
    display: grid;
    grid-template-columns: 260px 1fr 240px; 
    height: calc(100vh - 80px);
    background: #0d0d0d;
  }

  .wiki-container:not(:has(.wiki-toc)) {
    grid-template-columns: 260px 1fr;
  }

  .wiki-sidebar {
    background: #050505;
    border-right: 1px solid #1a1a1a;
    padding: 20px 10px;
    overflow-y: auto;
  }

  .wiki-main {
    padding: 40px 60px;
    overflow-y: auto;
    background: #0d0d0d;
    scroll-behavior: smooth;
  }

  .content-header h1 {
    font-size: 2.2rem;
    color: #fff;
    margin-bottom: 30px;
  }

  .wiki-toc {
    padding: 40px 20px;
    border-left: 1px solid #1a1a1a;
    background: #050505;
    overflow-y: auto;
  }

  .sidebar-header { font-size: 0.75rem; color: #444; margin-bottom: 15px; padding-left: 10px; text-transform: uppercase; letter-spacing: 1px; }
  .toc-title { color: #555; font-size: 0.8rem; margin-bottom: 15px; font-weight: bold; }
  
  .toc-link { 
    display: block; 
    color: #666; 
    text-decoration: none; 
    font-size: 0.85rem; 
    margin-bottom: 10px;
    transition: color 0.2s;
  }
  
  .toc-link:hover { color: #3498db; }
  
  /* Вложенность в TOC */
  .toc-link.depth-3 { margin-left: 15px; font-size: 0.8rem; }
  
  @media (max-width: 1100px) {
    .wiki-toc { display: none; }
    .wiki-container { grid-template-columns: 250px 1fr !important; }
  }
</style>
