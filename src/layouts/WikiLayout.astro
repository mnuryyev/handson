---
import MainLayout from './MainLayout.astro';
import WikiSearch from '../components/WikiSearch.astro';

const { title, lang = "ru", searchData = [], date } = Astro.props; 

// Форматируем дату в строгий ISO формат YYYY-MM-DD
const formattedDate = date ? new Date(date).toISOString().split('T')[0] : null;

// Локализация текста заголовка даты
const dateLabel = lang === 'en' ? 'Updated' : 'Обновлено';
---

<MainLayout title={title}>
  <div class="wiki-container">
    <div class="mobile-wiki-header">
      <button id="wiki-mobile-toggle" class="mobile-toggle-btn">
        <span>☰</span> {lang === 'en' ? 'Wiki Menu' : 'Разделы Wiki'}
      </button>
    </div>

    <aside class="wiki-sidebar" id="wiki-sidebar">
      <div class="sidebar-header">Wiki Navigation</div>
      
      <div class="search-section">
        {searchData && searchData.length > 0 && (
          <WikiSearch lang={lang} searchData={searchData} />
        )}
      </div>
      
      <div class="tree-section">
        <slot name="sidebar" />
      </div>
    </aside>

    <article class="wiki-main">
      <div class="wiki-content-wrapper">
        <header class="content-header">
          <h1>{title}</h1>
          {formattedDate && (
            <time class="post-date">
              {dateLabel}: {formattedDate}
            </time>
          )}
        </header>
        
        <hr class="header-divider" />

        <section class="markdown-body">
          <slot />
        </section>
      </div>
    </article>

    <div id="sidebar-overlay" class="sidebar-overlay"></div>
  </div>
</MainLayout>

<script is:inline>
  function handleExternalLinks() {
    const markdownContainer = document.querySelector('.markdown-body');
    if (!markdownContainer) return;
    const links = markdownContainer.querySelectorAll('a');
    links.forEach(link => {
      if (link.hostname && link.hostname !== window.location.hostname) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    });
  }

  function initMobileMenu() {
    const btn = document.getElementById('wiki-mobile-toggle');
    const sidebar = document.getElementById('wiki-sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    if (!btn || !sidebar) return;

    const toggle = () => {
      sidebar.classList.toggle('active');
      overlay?.classList.toggle('active');
    };

    btn.addEventListener('click', toggle);
    overlay?.addEventListener('click', toggle);
    sidebar.addEventListener('click', (e) => {
      if (e.target.closest('a')) {
        sidebar.classList.remove('active');
        overlay?.classList.remove('active');
      }
    });
  }

  handleExternalLinks();
  initMobileMenu();
  document.addEventListener('astro:after-swap', () => {
    handleExternalLinks();
    initMobileMenu();
  });
</script>

<style is:global>
  /* --- СКРОЛЛБАР --- */
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: rgba(62, 166, 255, 0.4); }
  * { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.1) transparent; }

  /* --- WIKI MARKDOWN --- */
  .markdown-body {
    font-size: 16px;
    line-height: 1.75;
    color: #c8d6e8;
  }

  .markdown-body h1,
  .markdown-body h2,
  .markdown-body h3 {
    font-weight: 700;
    color: #fff;
    margin-top: 1.8em;
    margin-bottom: 0.55em;
  }

  .markdown-body h1 { font-size: 1.75rem; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 0.35em; }
  .markdown-body h2 { font-size: 1.35rem; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 0.3em; }
  .markdown-body h3 { font-size: 1.15rem; }

  .markdown-body blockquote {
    margin: 16px 0;
    padding: 10px 16px;
    color: #94a3b8;
    border-left: 3px solid var(--accent, #3ea6ff);
    background: rgba(62, 166, 255, 0.06);
    border-radius: 0 8px 8px 0;
  }

  .markdown-body table {
    display: block;
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 20px 0;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.02);
    border-radius: 10px;
  }

  .markdown-body th {
    background: rgba(255,255,255,0.04);
    color: var(--accent, #3ea6ff);
    padding: 10px 14px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    text-align: left;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.7px;
  }

  .markdown-body td {
    padding: 9px 14px;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    color: #a8b8cc;
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .markdown-body td:nth-child(3) { white-space: normal; min-width: 250px; max-width: 450px; }
  .markdown-body tr:hover td { background: rgba(255,255,255,0.02); }

  .markdown-body :not(pre) > code {
    background: rgba(62, 166, 255, 0.08);
    color: #7dd3fc;
    padding: 0.15em 0.45em;
    border-radius: 5px;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.855em;
    border: 1px solid rgba(62, 166, 255, 0.15);
  }

  .markdown-body pre {
    background: rgba(255,255,255,0.025);
    padding: 18px 20px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.07);
    overflow-x: auto;
    margin: 1.2em 0;
  }

  .markdown-body pre code {
    font-size: 0.825rem;
    background: transparent;
    padding: 0;
    border: none;
    color: #cdd9e5;
  }

  .markdown-body ul, .markdown-body ol { padding-left: 1.8em; margin-bottom: 14px; }
  .markdown-body li { margin-bottom: 6px; }
  .markdown-body li::marker { color: var(--accent, #3ea6ff); }
  .markdown-body a { color: var(--accent, #3ea6ff); text-decoration: none; }
  .markdown-body a:hover { text-decoration: underline; }
  .markdown-body p { margin-bottom: 1em; }
  .markdown-body img { max-width: 100%; border-radius: 8px; margin: 1.2em 0; border: 1px solid rgba(255,255,255,0.07); }
</style>

<style>
  .wiki-container {
    display: grid;
    grid-template-columns: 256px 1fr;
    min-height: calc(100vh - var(--nav-height));
    background: var(--bg, #09090f);
    position: relative;
    align-items: start;
    max-width: 1400px;
    margin: 0 auto;
  }

  .wiki-content-wrapper {
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
  }

  .mobile-wiki-header {
    display: none;
    background: var(--bg-2, #0d0d17);
    padding: 10px 16px;
    border-bottom: 1px solid var(--border);
    grid-column: 1 / -1;
  }

  /* ── SIDEBAR ─────────────────────────────────────── */
  .wiki-sidebar {
    background: var(--bg-2, #0d0d17);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    position: sticky;
    top: var(--nav-height);
    height: calc(100vh - var(--nav-height));
    overflow-y: auto;
  }

  .sidebar-header {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-3, #3d4a5c);
    padding: 20px 16px 8px;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    flex-shrink: 0;
  }

  .search-section {
    padding: 8px 12px 4px;
    flex-shrink: 0;
  }

  .tree-section {
    flex-grow: 1;
    overflow-y: auto;
    padding: 6px 8px 30px;
  }

  /* ── MAIN CONTENT ────────────────────────────────── */
  .wiki-main {
    padding: 40px 56px;
    min-height: 0;
    overflow-wrap: break-word;
    word-break: break-word;
    min-width: 0;
  }

  .post-date {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--text-3, #3d4a5c);
    margin-top: 10px;
    font-family: 'JetBrains Mono', monospace;
  }

  .header-divider {
    border: 0;
    border-top: 1px solid rgba(255,255,255,0.07);
    margin: 20px 0 28px;
  }

  .content-header h1 {
    font-size: 2.2rem;
    font-weight: 800;
    color: #fff;
    margin: 0;
    letter-spacing: -0.5px;
    line-height: 1.2;
  }

  /* ── MOBILE TOGGLE ───────────────────────────────── */
  .mobile-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    color: var(--text-2);
    padding: 7px 14px;
    border-radius: 8px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .mobile-toggle-btn:hover {
    border-color: var(--border-2);
    color: #fff;
    background: rgba(255,255,255,0.07);
  }

  .sidebar-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(2px);
    z-index: 1000;
    display: none;
  }

  /* ── RESPONSIVE ──────────────────────────────────── */
  @media (max-width: 1440px) {
    .wiki-container { max-width: 100%; }
  }

  @media (max-width: 900px) {
    .wiki-main { padding: 32px 36px; }
  }

  @media (max-width: 768px) {
    .wiki-container {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .wiki-content-wrapper { max-width: 100%; }

    .mobile-wiki-header {
      display: flex;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 900;
    }

    .wiki-sidebar {
      position: fixed;
      top: 0;
      left: -300px;
      width: 280px;
      height: 100vh;
      z-index: 1050;
      transition: left 0.3s ease;
      box-shadow: 8px 0 32px rgba(0, 0, 0, 0.6);
    }

    .wiki-sidebar.active { left: 0; }
    .sidebar-overlay.active { display: block; }

    .wiki-main {
      padding: 20px 16px !important;
      width: 100%;
      max-width: 100vw;
    }

    .content-header h1 { font-size: 1.6rem; }
    body:has(.wiki-sidebar.active) { overflow: hidden; }
  }

  @media (max-width: 480px) {
    .content-header h1 { font-size: 1.3rem; }
  }
</style>
