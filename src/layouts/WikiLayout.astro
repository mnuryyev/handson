---
import MainLayout from './MainLayout.astro';
const { title } = Astro.props; // Убрали headings, так как TOC больше нет
---
<MainLayout title={title}>
  <div class="wiki-container">
    <aside class="wiki-sidebar">
      <div class="sidebar-header">Wiki</div>
      <slot name="sidebar" />
    </aside>

    <article class="wiki-main">
      <header class="content-header">
        <h1>{title}</h1>
      </header>
      <section class="markdown-body">
        <slot />
      </section>
    </article>
  </div>
</MainLayout>

<script is:inline>
  function handleExternalLinks() {
    const markdownContainer = document.querySelector('.markdown-body');
    if (!markdownContainer) return;

    const links = markdownContainer.querySelectorAll('a');
    links.forEach(link => {
      if (link.hostname && link.hostname !== window.location.hostname) {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      }
    });
  }

  handleExternalLinks();
  // Если используешь View Transitions:
  document.addEventListener('astro:after-swap', handleExternalLinks);
</script>

<style is:global>
  /* СТИЛИЗАЦИЯ СКРОЛЛБАРА (Dark Mode) */
  /* Для Chrome, Safari и Edge */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #0d0d0d; 
  }
  ::-webkit-scrollbar-thumb {
    background: #222; 
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #333; 
  }

  /* Для Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: #222 #0d0d0d;
  }

  /* Контент Markdown */
  .markdown-body {
    color: #ccc;
    line-height: 1.6;
    font-size: 1.05rem;
    max-width: 900px; /* Ограничиваем ширину текста для удобства чтения, но центрируем */
    margin: 0 auto;
  }

  .markdown-body h1, .markdown-body h2, .markdown-body h3 {
    color: #fff;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .markdown-body img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid #1a1a1a;
    margin: 24px 0;
  }

  .video-container {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    background: #000;
    border-radius: 12px;
    margin: 24px 0;
  }

  .video-container iframe {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%; border: 0;
  }

  .markdown-body a {
    color: #3498db;
    text-decoration: none;
  }
  
  .markdown-body a:hover {
    text-decoration: underline;
  }
</style>

<style>
  .wiki-container {
    display: grid;
    /* Оставляем только 2 колонки: Сайдбар и Контент */
    grid-template-columns: 260px 1fr; 
    height: calc(100vh - 80px);
    background: #0d0d0d;
    overflow: hidden;
  }

  .wiki-sidebar {
    background: #050505;
    border-right: 1px solid #1a1a1a;
    padding: 20px 10px;
    overflow-y: auto;
  }

  .wiki-main {
    padding: 40px 80px; /* Увеличили боковые отступы для солидности */
    overflow-y: auto;
    background: #0d0d0d;
    scroll-behavior: smooth;
  }

  .content-header {
    max-width: 900px;
    margin: 0 auto 40px auto;
  }

  .content-header h1 {
    font-size: 2.5rem;
    color: #fff;
    margin: 0;
  }

  .sidebar-header { 
    font-size: 0.7rem; 
    color: #444; 
    margin-bottom: 15px; 
    padding-left: 10px; 
    text-transform: uppercase; 
    letter-spacing: 1.5px; 
  }

  @media (max-width: 768px) {
    .wiki-container {
      grid-template-columns: 1fr; /* На мобилках сайдбар можно скрыть или перестроить */
    }
    .wiki-sidebar { display: none; }
    .wiki-main { padding: 20px; }
  }
</style>
