---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import LangSwitcher from '../components/LangSwitcher.astro';

const base = import.meta.env.BASE_URL;

// Генерируем правильную каноническую ссылку для Google
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Принимаем пропсы. tags оставляем в пропсах на случай, если они понадобятся для мета-тегов
const { title, tags = [] } = Astro.props; 
const { pathname } = Astro.url;
const lang = pathname.includes('/en/') ? 'en' : 'ru';

const nav = {
  ru: {
    articles: 'Сети',
    labs: 'Безопасность',
    projects: 'Проекты',
    writeups: 'Writeups',
    tools: 'Tools',
    wiki: 'Wiki',
  },
  en: {
    articles: 'Networks',
    labs: 'Security',
    projects: 'Projects',
    writeups: 'Writeups',
    tools: 'Tools',
    wiki: 'Wiki',
  }
};

const t = nav[lang];
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <nav class="navbar">
      <div class="container nav-wrapper">
        <div class="nav-logo">
          <a href={`${base}${lang}/`}>HANDS<span>.ON</span></a>
        </div>

        <button class="menu-toggle" id="menu-toggle" aria-label="Toggle Menu">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>

        <ul class="nav-links" id="nav-menu">
          <li><a href={`${base}${lang}/articles/1`}>{t.articles}</a></li>
          <li><a href={`${base}${lang}/labs/1`}>{t.labs}</a></li>
          <li><a href={`${base}${lang}/writeups`}>{t.writeups}</a></li>
          <li><a href={`${base}${lang}/tools/1`}>{t.tools}</a></li>
          <li><a href={`${base}${lang}/projects`}>{t.projects}</a></li>
          <li><a href={`${base}${lang}/wiki`}>{t.wiki}</a></li>
          <li class="nav-actions">
            <LangSwitcher />
          </li>
          <li>
            <a href="https://github.com/mnuryyev" class="btn-projects" target="_blank" rel="noopener noreferrer">Github</a>
          </li>
        </ul>
      </div>
    </nav>

    <main class="container main-content">
      <div class="markdown-content">
        <slot />
      </div>
    </main>

    <Footer lang={lang} />

    <script is:inline>
      const menuToggle = document.getElementById('menu-toggle');
      const navMenu = document.getElementById('nav-menu');
      if (menuToggle && navMenu) {
        menuToggle.addEventListener('click', () => {
          menuToggle.classList.toggle('is-active');
          navMenu.classList.toggle('is-open');
          document.body.classList.toggle('menu-open');
        });
      }
    </script>
  </body>
</html>

<style is:global>
  body.menu-open {
    overflow: hidden;
  }

  /* --- Общие стили для тегов (используются в статьях и списках) --- */
  .tag-item {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #3ea6ff; 
    background: rgba(62, 166, 255, 0.07);
    padding: 4px 12px;
    border-radius: 6px;
    border: 1px solid rgba(62, 166, 255, 0.2);
    text-decoration: none !important;
    transition: all 0.2s ease;
  }

  .tag-item:hover {
    background: #3ea6ff;
    color: #000 !important;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(62, 166, 255, 0.3);
  }

  .main-content {
    flex: 1;
    width: 100%;
    padding-top: 40px;
    padding-bottom: 60px;
  }

  .nav-actions {
    padding: 0 15px;
    border-left: 1px solid #222;
    border-right: 1px solid #222;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 30px;
    height: 21px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 1100;
  }

  .menu-toggle .bar {
    width: 100%;
    height: 3px;
    background-color: #fff;
    border-radius: 10px;
    transition: all 0.3s ease-in-out;
  }

  .menu-toggle.is-active .bar:nth-child(2) { opacity: 0; }
  .menu-toggle.is-active .bar:nth-child(1) { transform: translateY(9px) rotate(45deg); }
  .menu-toggle.is-active .bar:nth-child(3) { transform: translateY(-9px) rotate(-45deg); }

  @media (max-width: 992px) {
    .menu-toggle { display: flex; }
    .nav-links {
      position: fixed;
      top: 0;
      right: -100%;
      width: 100%;
      height: 100vh;
      background: #0b0b0b;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 8px;
      transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 1050;
      padding: 40px 20px;
    }
    .nav-links.is-open { right: 0; }
    .nav-links li { width: 100%; text-align: center; display: flex; justify-content: center; }
    .nav-links a { font-size: 1.3rem; padding: 10px 0; display: block; width: 100%; }
    .nav-actions { border: none; border-top: 1px solid #1a1a1a; border-bottom: 1px solid #1a1a1a; padding: 16px 0; width: 100%; display: flex; justify-content: center; }
  }

  @media (max-width: 768px) {
    .main-content { padding-top: 24px; padding-bottom: 40px; }
    .markdown-content table, .markdown-body table { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .markdown-content h1 { font-size: 1.6rem; }
    .markdown-content h2 { font-size: 1.3rem; }
    .markdown-content h3 { font-size: 1.1rem; }
    .markdown-content pre { font-size: 0.78em; }
  }

  @media (max-width: 480px) { .container { padding: 0 14px; } }
</style>
