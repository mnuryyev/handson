---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import LangSwitcher from '../components/LangSwitcher.astro';

const base = import.meta.env.BASE_URL;

// Канонический URL
const { pathname } = Astro.url;
const normalizedPathname = pathname.endsWith('/') ? pathname : `${pathname}/`;
const canonicalURL = new URL(normalizedPathname, Astro.site);

const { title } = Astro.props;
const lang = pathname.includes('/en/') ? 'en' : 'ru';

const nav = {
  ru: {
    articles: 'Сети',
    labs: 'Безопасность',
    projects: 'Проекты',
    writeups: 'Writeups',
    tools: 'Tools',
    wiki: 'Wiki',
  },
  en: {
    articles: 'Networks',
    labs: 'Security',
    projects: 'Projects',
    writeups: 'Writeups',
    tools: 'Tools',
    wiki: 'Wiki',
  }
};
const t = nav[lang];
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="canonical" href={canonicalURL.href} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
</head>
<body>
  <nav class="navbar">
    <div class="nav-wrapper">
      <div class="nav-logo">
        <a href={`${base}${lang}/`}>HANDS<span>.ON</span></a>
      </div>

      <button class="menu-toggle" id="menu-toggle" aria-label="Toggle Menu">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>

      <ul class="nav-links" id="nav-menu">
        <li><a href={`${base}${lang}/articles/1/`}>{t.articles}</a></li>
        <li><a href={`${base}${lang}/labs/1/`}>{t.labs}</a></li>
        <li><a href={`${base}${lang}/writeups/`}>{t.writeups}</a></li>
        <li><a href={`${base}${lang}/tools/1/`}>{t.tools}</a></li>
        <li><a href={`${base}${lang}/projects/`}>{t.projects}</a></li>
        <li><a href={`${base}${lang}/wiki/`}>{t.wiki}</a></li>
        
        <li class="nav-actions">
          <LangSwitcher />
        </li>
        <li>
          <a href="https://github.com/mnuryyev" class="btn-github" target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
        </li>
      </ul>
    </div>
  </nav>

  <main class="main-content">
    <div class="markdown-content">
      <slot />
    </div>
  </main>

  <Footer lang={lang} />

  <script>
    const menuToggle = document.getElementById('menu-toggle');
    const navMenu = document.getElementById('nav-menu');
    const navbar = document.querySelector('.navbar');
    let lastScrollY = window.scrollY;

    // Открытие/закрытие меню
    menuToggle.addEventListener('click', () => {
      menuToggle.classList.toggle('active');
      navMenu.classList.toggle('open');
      document.body.classList.toggle('menu-open');
    });

    // Скрытие navbar при скролле вниз
    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY;
      if (currentScrollY > lastScrollY && currentScrollY > 80) {
        navbar.classList.add('navbar--hidden');
        navMenu.classList.remove('open');
        menuToggle.classList.remove('active');
      } else {
        navbar.classList.remove('navbar--hidden');
      }
      lastScrollY = currentScrollY;
    });
  </script>
</body>
</html>
