---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import LangSwitcher from '../components/LangSwitcher.astro';

const base = import.meta.env.BASE_URL;

// 1. ПРАВИЛЬНАЯ ЛОГИКА ДЛЯ GOOGLE:
// Гарантируем, что канонический URL всегда заканчивается на слэш
const { pathname } = Astro.url;
const normalizedPathname = pathname.endsWith('/') ? pathname : `${pathname}/`;
const canonicalURL = new URL(normalizedPathname, Astro.site);

const { title, tags = [] } = Astro.props; 
const lang = pathname.includes('/en/') ? 'en' : 'ru';

const nav = {
  ru: {
    articles: 'Сети',
    labs: 'Безопасность',
    projects: 'Проекты',
    writeups: 'Writeups',
    tools: 'Tools',
    wiki: 'Wiki',
  },
  en: {
    articles: 'Networks',
    labs: 'Security',
    projects: 'Projects',
    writeups: 'Writeups',
    tools: 'Tools',
    wiki: 'Wiki',
  }
};

const t = nav[lang];
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <nav class="navbar">
      <div class="container nav-wrapper">
        <div class="nav-logo">
          <a href={`${base}${lang}/`}>HANDS<span>.ON</span></a>
        </div>

        <button class="menu-toggle" id="menu-toggle" aria-label="Toggle Menu">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>

        <ul class="nav-links" id="nav-menu">
          <li><a href={`${base}${lang}/articles/1/`}>{t.articles}</a></li>
          <li><a href={`${base}${lang}/labs/1/`}>{t.labs}</a></li>
          <li><a href={`${base}${lang}/writeups/`}>{t.writeups}</a></li>
          <li><a href={`${base}${lang}/tools/1/`}>{t.tools}</a></li>
          <li><a href={`${base}${lang}/projects/`}>{t.projects}</a></li>
          <li><a href={`${base}${lang}/wiki/`}>{t.wiki}</a></li>
          <li class="nav-actions">
            <LangSwitcher />
          </li>
          <li>
            <a href="https://github.com/mnuryyev" class="btn-projects" target="_blank" rel="noopener noreferrer">Github</a>
          </li>
        </ul>
      </div>
    </nav>

    <main class="container main-content">
      <div class="markdown-content">
        <slot />
      </div>
    </main>

    <Footer lang={lang} />

<script is:inline>
      const menuToggle = document.getElementById('menu-toggle');
      const navMenu = document.getElementById('nav-menu');
      const navbar = document.querySelector('.navbar');
      let lastScrollY = window.scrollY;

      // 1. Твоя логика клика (кнопка справа)
      if (menuToggle && navMenu) {
        menuToggle.addEventListener('click', () => {
          menuToggle.classList.toggle('is-active');
          navMenu.classList.toggle('is-open');
          document.body.classList.toggle('menu-open');
        });
      }

      // 2. Умное появление при скролле вверх
      window.addEventListener('scroll', () => {
        const currentScrollY = window.scrollY;

        // Если скроллим вниз и проехали больше 100px — прячем
        if (currentScrollY > lastScrollY && currentScrollY > 100) {
          navbar.classList.add('navbar--hidden');
          // Если меню было открыто, лучше его закрыть при начале скролла
          navMenu.classList.remove('is-open');
          menuToggle.classList.remove('is-active');
        } 
        // Если скроллим вверх — показываем
        else {
          navbar.classList.remove('navbar--hidden');
        }
        
        lastScrollY = currentScrollY;
      });
    </script>
  </body>
</html>

<style is:global>
  body.menu-open { overflow: hidden; }

  /* Теги */
  .tag-item {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #3ea6ff; 
    background: rgba(62, 166, 255, 0.07);
    padding: 4px 12px;
    border-radius: 6px;
    border: 1px solid rgba(62, 166, 255, 0.2);
    transition: all 0.2s ease;
  }

  .tag-item:hover {
    background: #3ea6ff;
    color: #000 !important;
    transform: translateY(-2px);
  }

  /* Основной контент (учитываем высоту шапки) */
  .main-content {
    flex: 1;
    width: 100%;
    margin-top: 64px; /* Чтобы не пряталось под навбаром */
    padding-top: 40px;
    padding-bottom: 60px;
  }

  /* Селектор языка */
  .nav-actions {
    padding: 0 15px;
    border-left: 1px solid #222;
    border-right: 1px solid #222;
  }

  /* КНОПКА МЕНЮ (БУРГЕР) */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 26px;
    height: 18px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 2000; /* Самый высокий слой */
  }

  .menu-toggle .bar {
    width: 100%;
    height: 2px;
    background-color: #fff;
    border-radius: 2px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Анимация в крестик */
  .menu-toggle.is-active .bar:nth-child(2) { opacity: 0; transform: translateX(20px); }
  .menu-toggle.is-active .bar:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .menu-toggle.is-active .bar:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  /* МОБИЛЬНОЕ МЕНЮ НА ВЕСЬ ЭКРАН */
  @media (max-width: 992px) {
    .menu-toggle { display: flex; }

    .nav-links {
      position: fixed;
      top: 0;
      right: -100%;
      width: 100% !important; /* На весь экран */
      height: 100vh !important;
      background: #0f0f0f !important;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 20px !important;
      transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
      z-index: 1500 !important;
      padding: 40px 20px;
      margin: 0 !important;
    }

    .nav-links.is-open { 
      right: 0 !important; 
    }

    .nav-links li { width: 100%; text-align: center; }
    .nav-links a { font-size: 1.6rem; font-weight: 700; color: #fff; display: block; padding: 15px 0; }
    
    .nav-actions { 
      border: none; 
      border-top: 1px solid #222; 
      border-bottom: 1px solid #222; 
      padding: 20px 0; 
      width: 100%; 
      display: flex; 
      justify-content: center; 
    }
  }

  @media (max-width: 768px) {
    .main-content { padding-top: 24px; }
    .markdown-content h1 { font-size: 1.8rem; }
  }
</style>
