---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
const base = import.meta.env.BASE_URL;

const { title } = Astro.props;
const { pathname } = Astro.url;

const lang = pathname.includes('/en/') ? 'en' : 'ru';

const nav = {
  ru: {
    articles: 'Сети',
    labs: 'Безопасность',
    projects: 'Проекты',
    writeups: 'Writeups',
    tools: 'Tools',
    wiki: 'Wiki',
  },
  en: {
    articles: 'Networks',
    labs: 'Security',
    projects: 'Projects',
    writeups: 'Writeups',
    tools: 'Tools',
    wiki: 'Wiki',
  }
};

const t = nav[lang];
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <nav class="navbar">
      <div class="container nav-wrapper">
        <div class="nav-logo">
          <a href={`${base}${lang}/`}>HANDS<span>.ON</span></a>
        </div>

        <button class="menu-toggle" id="menu-toggle" aria-label="Toggle Menu">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>

        <ul class="nav-links" id="nav-menu">
          <li><a href={`${base}${lang}/articles/1`}>{t.articles}</a></li>
          <li><a href={`${base}${lang}/labs/1`}>{t.labs}</a></li>
          <li><a href={`${base}${lang}/writeups`}>{t.writeups}</a></li>
          <li><a href={`${base}${lang}/tools/1`}>{t.tools}</a></li>
          <li><a href={`${base}${lang}/projects`}>{t.projects}</a></li>
          <li><a href={`${base}${lang}/wiki`}>{t.wiki}</a></li>
          
          <li class="nav-actions">
            <LangSwitcher />
          </li>
          <li>
            <a href="https://github.com/mnuryyev" class="btn-projects" target="_blank" rel="noopener noreferrer">Github</a>
          </li>
        </ul>
      </div>
    </nav>

    <main class="container main-content">
      <slot />
    </main>

    <Footer lang={lang} />

    <script is:inline>
      const menuToggle = document.getElementById('menu-toggle');
      const navMenu = document.getElementById('nav-menu');

      if (menuToggle && navMenu) {
        menuToggle.addEventListener('click', () => {
          menuToggle.classList.toggle('is-active');
          navMenu.classList.toggle('is-open');
          document.body.classList.toggle('menu-open'); // Запрет скролла при открытом меню
        });
      }
    </script>
  </body>
</html>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin: 0;
    background-color: #000;
    color: #fff;
    font-family: system-ui, -apple-system, sans-serif;
  }

  body.menu-open {
    overflow: hidden;
  }
  
  .main-content {
    flex: 1;
    width: 100%;
    padding-top: 40px;
    padding-bottom: 60px;
  }

  .navbar {
    border-bottom: 1px solid #1a1a1a;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .nav-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 80px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 25px;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    text-decoration: none;
    color: #888;
    font-weight: 500;
    transition: 0.3s;
    font-size: 0.95rem;
  }

  .nav-links a:hover {
    color: #fff;
  }

  .nav-logo a {
    font-size: 1.5rem;
    font-weight: bold;
    color: #fff;
    text-decoration: none;
  }

  .nav-logo span {
    color: var(--accent);
  }

  .nav-actions {
    padding: 0 15px;
    border-left: 1px solid #222;
    border-right: 1px solid #222;
  }

  .btn-projects {
    background: #fff;
    color: #000 !important;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 0.9rem;
  }

  /* --- СТИЛИ БУРГЕРА --- */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 30px;
    height: 21px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 1100;
  }

  .menu-toggle .bar {
    width: 100%;
    height: 3px;
    background-color: #fff;
    border-radius: 10px;
    transition: all 0.3s ease-in-out;
  }

  /* Анимация крестика */
  .menu-toggle.is-active .bar:nth-child(2) { opacity: 0; }
  .menu-toggle.is-active .bar:nth-child(1) { transform: translateY(9px) rotate(45deg); }
  .menu-toggle.is-active .bar:nth-child(3) { transform: translateY(-9px) rotate(-45deg); }

  /* --- МОБИЛЬНАЯ АДАПТАЦИЯ --- */
  @media (max-width: 992px) {
    .menu-toggle { display: flex; }

    .nav-links {
      position: fixed;
      top: 0;
      right: -100%;
      width: 100%;
      height: 100vh;
      background: #000;
      flex-direction: column;
      justify-content: center;
      gap: 30px;
      transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 1050;
    }

    .nav-links.is-open {
      right: 0;
    }

    .nav-links a {
      font-size: 1.4rem;
    }

    .nav-actions {
      border: none;
      padding: 20px 0;
    }

    .main-content { padding-top: 20px; }
  }
</style>
